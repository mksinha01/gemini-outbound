      "html": "\n<div class=\"w-[1280px] min-h-[800px] bg-white text-[#1A202C] font-['IBM_Plex_Sans'] relative overflow-hidden flex flex-col\" data-kid=\"0\">\n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=IBM+Plex+Sans:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n    .font-mono { font-family: 'IBM Plex Mono', monospace; }\n\n    .hairline-border {\n      border: 1px solid #d0d0cc;\n    }\n\n    .terminal-shadow {\n      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);\n    }\n\n    .left-accent::before {\n      content: '';\n      position: absolute;\n      left: 0;\n      top: 0;\n      bottom: 0;\n      width: 4px;\n      background: linear-gradient(180deg, #319795, #4fd1c5);\n    }\n\n    /* Subtle background pattern */\n    .bg-pattern {\n      background-image: radial-gradient(#319795 0.5px, transparent 0.5px);\n      background-size: 24px 24px;\n      opacity: 0.03;\n    }\n  </style>\n\n  \n  <div class=\"absolute inset-0 z-0 bg-pattern pointer-events-none\" data-kid=\"2\"></div>\n\n  \n  <header class=\"relative z-10 px-16 py-12 flex justify-between items-end\" data-kid=\"3\">\n    <div class=\"relative pl-8 left-accent\" data-kid=\"4\">\n      <div class=\"flex items-center gap-2 mb-2\" data-kid=\"5\">\n        <span class=\"text-[#319795] font-heading font-bold tracking-[0.2em] text-[10px] uppercase\" data-kid=\"6\">Architecture Slide 04</span>\n      </div>\n      <h1 class=\"text-6xl font-heading font-bold tracking-tight text-[#1A202C]\" data-kid=\"7\">\n        Technology <span class=\"text-[#319795]\" data-kid=\"8\">Stack</span>\n      </h1>\n    </div>\n    <div class=\"text-right pb-2\" data-kid=\"9\">\n      <div class=\"text-[#1A202C]/40 font-heading text-[10px] uppercase tracking-widest font-bold\" data-kid=\"10\">Project OutboundAI</div>\n      <div class=\"text-[#319795] font-heading text-xs font-semibold mt-1\" data-kid=\"11\">Core Architecture v2.0</div>\n    </div>\n  </header>\n\n  \n  <main class=\"flex-grow relative z-10 px-16 grid grid-cols-12 gap-12 items-center\" data-kid=\"12\">\n    \n    \n    <div class=\"col-span-5 flex flex-col justify-center\" data-kid=\"13\">\n      <div class=\"mb-10\" data-kid=\"14\">\n        <h3 class=\"text-lg font-heading font-bold text-[#1A202C] mb-2 uppercase tracking-wider\" data-kid=\"15\">Foundation Layers</h3>\n        <p class=\"text-sm text-[#1A202C]/60 leading-relaxed\" data-kid=\"16\">Leveraging best-in-class cloud infrastructure and AI models to ensure low-latency voice interactions.</p>\n      </div>\n\n      <div class=\"grid grid-cols-2 gap-6\" data-kid=\"17\">\n        \n        <div class=\"group cursor-pointer\" data-kid=\"18\">\n          <div class=\"w-full aspect-square bg-[#F5F7FA] rounded-3xl hairline-border flex flex-col items-center justify-center gap-4 transition-all duration-300 group-hover:bg-white group-hover:shadow-xl group-hover:border-[#319795]/30\" data-kid=\"19\">\n            <div class=\"w-16 h-16 rounded-2xl bg-white shadow-sm flex items-center justify-center text-[#319795] group-hover:scale-110 transition-transform\" data-kid=\"20\">\n              <i class=\"ti ti-sparkles text-3xl\" data-kid=\"21\"></i>\n            </div>\n            <div class=\"text-center px-4\" data-kid=\"22\">\n              <span class=\"block text-sm font-heading font-bold text-[#1A202C]\" data-kid=\"23\">Google Gemini</span>\n              <span class=\"block text-[10px] text-[#1A202C]/40 uppercase tracking-widest font-medium mt-1\" data-kid=\"24\">LLM Logic</span>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"group cursor-pointer\" data-kid=\"25\">\n          <div class=\"w-full aspect-square bg-[#F5F7FA] rounded-3xl hairline-border flex flex-col items-center justify-center gap-4 transition-all duration-300 group-hover:bg-white group-hover:shadow-xl group-hover:border-[#319795]/30\" data-kid=\"26\">\n            <div class=\"w-16 h-16 rounded-2xl bg-white shadow-sm flex items-center justify-center text-[#319795] group-hover:scale-110 transition-transform\" data-kid=\"27\">\n              <i class=\"ti ti-broadcast text-3xl\" data-kid=\"28\"></i>\n            </div>\n            <div class=\"text-center px-4\" data-kid=\"29\">\n              <span class=\"block text-sm font-heading font-bold text-[#1A202C]\" data-kid=\"30\">LiveKit</span>\n              <span class=\"block text-[10px] text-[#1A202C]/40 uppercase tracking-widest font-medium mt-1\" data-kid=\"31\">Real-time RTCC</span>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"group cursor-pointer\" data-kid=\"32\">\n          <div class=\"w-full aspect-square bg-[#F5F7FA] rounded-3xl hairline-border flex flex-col items-center justify-center gap-4 transition-all duration-300 group-hover:bg-white group-hover:shadow-xl group-hover:border-[#319795]/30\" data-kid=\"33\">\n            <div class=\"w-16 h-16 rounded-2xl bg-white shadow-sm flex items-center justify-center text-[#319795] group-hover:scale-110 transition-transform\" data-kid=\"34\">\n              <i class=\"ti ti-database text-3xl\" data-kid=\"35\"></i>\n            </div>\n            <div class=\"text-center px-4\" data-kid=\"36\">\n              <span class=\"block text-sm font-heading font-bold text-[#1A202C]\" data-kid=\"37\">Supabase</span>\n              <span class=\"block text-[10px] text-[#1A202C]/40 uppercase tracking-widest font-medium mt-1\" data-kid=\"38\">PostgreSQL</span>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"group cursor-pointer\" data-kid=\"39\">\n          <div class=\"w-full aspect-square bg-[#F5F7FA] rounded-3xl hairline-border flex flex-col items-center justify-center gap-4 transition-all duration-300 group-hover:bg-white group-hover:shadow-xl group-hover:border-[#319795]/30\" data-kid=\"40\">\n            <div class=\"w-16 h-16 rounded-2xl bg-white shadow-sm flex items-center justify-center text-[#319795] group-hover:scale-110 transition-transform\" data-kid=\"41\">\n              <i class=\"ti ti-phone text-3xl\" data-kid=\"42\"></i>\n            </div>\n            <div class=\"text-center px-4\" data-kid=\"43\">\n              <span class=\"block text-sm font-heading font-bold text-[#1A202C]\" data-kid=\"44\">Twilio</span>\n              <span class=\"block text-[10px] text-[#1A202C]/40 uppercase tracking-widest font-medium mt-1\" data-kid=\"45\">VoIP Gateway</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"col-span-7\" data-kid=\"46\">\n      <div class=\"bg-[#F5F7FA] hairline-border rounded-[14px] terminal-shadow overflow-hidden flex flex-col h-[520px]\" data-kid=\"47\">\n        \n        <div class=\"h-10 px-4 flex items-center justify-between border-b border-[#d0d0cc] bg-white\" data-kid=\"48\">\n          <div class=\"flex gap-2\" data-kid=\"49\">\n            <div class=\"w-3 h-3 rounded-full bg-[#FF5F57]\" data-kid=\"50\"></div>\n            <div class=\"w-3 h-3 rounded-full bg-[#FEBC2E]\" data-kid=\"51\"></div>\n            <div class=\"w-3 h-3 rounded-full bg-[#28C840]\" data-kid=\"52\"></div>\n          </div>\n          <div class=\"text-[10px] font-mono text-[#1A202C]/40 font-medium\" data-kid=\"53\">agent_orchestrator.py</div>\n          <div class=\"w-12\" data-kid=\"54\"></div> \n        </div>\n        \n        \n        <div class=\"p-8 flex-grow font-mono text-sm leading-relaxed overflow-hidden\" data-kid=\"55\">\n          <div class=\"text-[#319795] mb-2\" data-kid=\"56\">$ python run_agent.py --voice-pipeline</div>\n          <div class=\"space-y-1\" data-kid=\"57\">\n            <p data-kid=\"58\"><span class=\"text-[#319795]\" data-kid=\"59\">import</span> livekit.agents <span class=\"text-[#319795]\" data-kid=\"60\">as</span> agents</p>\n            <p data-kid=\"61\"><span class=\"text-[#319795]\" data-kid=\"62\">from</span> livekit.plugins <span class=\"text-[#319795]\" data-kid=\"63\">import</span> google, deepgram</p>\n            <p class=\"py-1\" data-kid=\"64\"></p>\n            <p data-kid=\"65\"><span class=\"text-purple-600\" data-kid=\"66\">async def</span> <span class=\"text-blue-600\" data-kid=\"67\">entrypoint</span>(ctx: agents.JobContext):</p>\n            <p class=\"pl-4\" data-kid=\"68\">    agent = agents.VoicePipelineAgent(</p>\n            <p class=\"pl-8\" data-kid=\"69\">        vad=ctx.wait_for_session().vad,</p>\n            <p class=\"pl-8\" data-kid=\"70\">        stt=deepgram.STT(),</p>\n            <p class=\"pl-8\" data-kid=\"71\">        llm=google.LLM(model=<span class=\"text-orange-600\" data-kid=\"72\">\"gemini-2.0-flash\"</span>),</p>\n            <p class=\"pl-8\" data-kid=\"73\">        tts=google.TTS(),</p>\n            <p class=\"pl-4\" data-kid=\"74\">    )</p>\n            <p class=\"pl-4\" data-kid=\"75\">    <span class=\"text-gray-400\" data-kid=\"76\"># Start the real-time interaction loop</span></p>\n            <p class=\"pl-4\" data-kid=\"77\">    <span class=\"text-[#319795] font-bold\" data-kid=\"78\">await</span> agent.start(ctx.room)</p>\n            <p class=\"py-2\" data-kid=\"79\"></p>\n            <p class=\"text-[#28C840]\" data-kid=\"80\">[INFO] Initializing Google Gemini 2.0 Brain...</p>\n            <p class=\"text-[#28C840]\" data-kid=\"81\">[INFO] LiveKit Voice Pipeline connected to room: session_8f2a</p>\n            <p class=\"text-[#28C840]\" data-kid=\"82\">[INFO] Streaming STT via Deepgram (latency: 140ms)</p>\n            <div class=\"flex items-center gap-1\" data-kid=\"83\">\n              <span class=\"text-[#1A202C]\" data-kid=\"84\">_</span>\n              <div class=\"w-2 h-4 bg-[#319795] animate-pulse\" data-kid=\"85\"></div>\n            </div>\n          </div>\n        </div>\n        \n        \n        <div class=\"h-12 bg-white border-t border-[#d0d0cc] flex items-center px-6 gap-6\" data-kid=\"86\">\n          <div class=\"flex items-center gap-2\" data-kid=\"87\">\n            <div class=\"w-2 h-2 rounded-full bg-[#28C840]\" data-kid=\"88\"></div>\n            <span class=\"text-[10px] font-heading font-bold uppercase tracking-widest text-[#1A202C]\" data-kid=\"89\">Service: Online</span>\n          </div>\n          <div class=\"h-4 w-[1px] bg-[#d0d0cc]\" data-kid=\"90\"></div>\n          <div class=\"flex items-center gap-2\" data-kid=\"91\">\n            <i class=\"ti ti-cpu text-sm text-[#319795]\" data-kid=\"92\"></i>\n            <span class=\"text-[10px] font-heading font-bold uppercase tracking-widest text-[#1A202C]/40\" data-kid=\"93\">Node: Oregon-01</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </main>\n\n  \n  <footer class=\"relative z-20 px-16 py-8 border-t border-[#F5F7FA] flex items-center justify-between text-[10px] font-heading uppercase tracking-[0.2em] text-[#1A202C]/30 bg-white\" data-kid=\"94\">\n    <div class=\"flex items-center gap-10\" data-kid=\"95\">\n      <div class=\"flex items-center gap-3\" data-kid=\"96\">\n        <div class=\"w-2 h-2 bg-[#319795] rounded-full\" data-kid=\"97\"></div>\n        <span data-kid=\"98\">Architecture: Modular Microservices</span>\n      </div>\n      <div class=\"flex items-center gap-3\" data-kid=\"99\">\n        <i class=\"ti ti-shield-check text-base opacity-50\" data-kid=\"100\"></i>\n        <span data-kid=\"101\">Security Layer: Active</span>\n      </div>\n    </div>\n    <div class=\"flex items-center gap-4\" data-kid=\"102\">\n      <span class=\"text-[#1A202C]\" data-kid=\"103\">Slide 04: Tech Stack</span>\n      <span class=\"text-[#d0d0cc]\" data-kid=\"104\">/</span>\n      <span class=\"text-[#1A202C]/40\" data-kid=\"105\">OutboundAI Presentation 2026</span>\n    </div>\n  </footer>\n\n</div>\n