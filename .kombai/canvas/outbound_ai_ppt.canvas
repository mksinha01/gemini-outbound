      "generation": {
        "prompt": "",
        "config": {}
      },
      "html": "\n<div class=\"bg-[#FFFFFF] text-[#1A202C] min-h-[900px] w-full font-sans relative overflow-hidden flex flex-col px-12 py-20\" data-kid=\"0\">\n    \n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        .font-plus { font-family: 'Plus Jakarta Sans', sans-serif; }\n        .font-inter { font-family: 'Inter', sans-serif; }\n\n        .roadmap-line {\n            width: 1px;\n            background: #319795;\n            position: absolute;\n            top: 0;\n            bottom: 0;\n            left: 7px;\n        }\n\n        .phase-dot {\n            width: 15px;\n            height: 15px;\n            background: #319795;\n            border-radius: 50%;\n            border: 4px solid white;\n            position: relative;\n            z-index: 10;\n        }\n\n        .phase-card {\n            transition: transform 0.3s ease, background-color 0.3s ease;\n        }\n\n        .phase-card:hover {\n            background-color: #F5F7FA;\n            transform: translateX(8px);\n        }\n    </style>\n\n    \n    <header class=\"mb-24 flex justify-between items-end\" data-kid=\"2\">\n        <div class=\"max-w-2xl\" data-kid=\"3\">\n            <div class=\"inline-flex items-center gap-2 mb-4\" data-kid=\"4\">\n                <span class=\"w-1.5 h-1.5 rounded-full bg-[#319795]\" data-kid=\"5\"></span>\n                <span class=\"text-[#319795] font-plus text-[12px] tracking-[0.2em] uppercase font-bold\" data-kid=\"6\">Implementation Phase</span>\n            </div>\n            <h1 class=\"text-6xl font-plus font-bold tracking-tight text-[#1A202C]\" data-kid=\"7\">Development Roadmap</h1>\n            <p class=\"text-[#1A202C]/60 font-inter text-xl mt-6 font-light leading-relaxed\" data-kid=\"8\">\n                A strategic four-stage deployment plan for our <span class=\"text-[#319795] font-medium\" data-kid=\"9\">Gemini-powered</span> voice infrastructure.\n            </p>\n        </div>\n        <div class=\"text-right hidden md:block\" data-kid=\"10\">\n            <span class=\"text-[80px] font-plus font-bold text-[#F5F7FA] leading-none\" data-kid=\"11\">05</span>\n        </div>\n    </header>\n\n    \n    <div class=\"flex-grow flex justify-center items-start\" data-kid=\"12\">\n        <div class=\"relative w-full max-w-4xl grid grid-cols-1 md:grid-cols-[auto_1fr] gap-x-12\" data-kid=\"13\">\n            \n            \n            <div class=\"relative flex flex-col items-center pt-2\" data-kid=\"14\">\n                <div class=\"roadmap-line opacity-20\" data-kid=\"15\"></div>\n                \n                \n                <div class=\"h-full flex flex-col justify-between items-center py-2\" data-kid=\"16\">\n                    <div class=\"phase-dot\" style=\"margin-top: 10px;\" data-kid=\"17\"></div>\n                    <div class=\"phase-dot\" style=\"margin-top: 120px;\" data-kid=\"18\"></div>\n                    <div class=\"phase-dot\" style=\"margin-top: 120px;\" data-kid=\"19\"></div>\n                    <div class=\"phase-dot\" style=\"margin-top: 120px; margin-bottom: 20px;\" data-kid=\"20\"></div>\n                </div>\n            </div>\n\n            \n            <div class=\"space-y-16\" data-kid=\"21\">\n                \n                <div class=\"phase-card p-4 rounded-xl\" data-kid=\"22\">\n                    <div class=\"flex items-baseline gap-4 mb-2\" data-kid=\"23\">\n                        <span class=\"font-plus text-xs font-bold text-[#319795] tracking-widest uppercase\" data-kid=\"24\">Phase 01</span>\n                        <h3 class=\"text-2xl font-plus font-bold text-[#1A202C]\" data-kid=\"25\">Voice Integration</h3>\n                    </div>\n                    <p class=\"text-[#1A202C]/60 text-lg leading-relaxed max-w-2xl\" data-kid=\"26\">\n                        Infrastructure setup using LiveKit for low-latency voice streams and professional SIP trunking integration to handle high-concurrency calls.\n                    </p>\n                </div>\n\n                \n                <div class=\"phase-card p-4 rounded-xl\" data-kid=\"27\">\n                    <div class=\"flex items-baseline gap-4 mb-2\" data-kid=\"28\">\n                        <span class=\"font-plus text-xs font-bold text-[#319795] tracking-widest uppercase\" data-kid=\"29\">Phase 02</span>\n                        <h3 class=\"text-2xl font-plus font-bold text-[#1A202C]\" data-kid=\"30\">Gemini Fine-tuning</h3>\n                    </div>\n                    <p class=\"text-[#1A202C]/60 text-lg leading-relaxed max-w-2xl\" data-kid=\"31\">\n                        Fine-tuning Gemini 1.5 Pro with specialized system prompts and context-rich datasets for natural, human-like sales dialogue.\n                    </p>\n                </div>\n\n                \n                <div class=\"phase-card p-4 rounded-xl\" data-kid=\"32\">\n                    <div class=\"flex items-baseline gap-4 mb-2\" data-kid=\"33\">\n                        <span class=\"font-plus text-xs font-bold text-[#319795] tracking-widest uppercase\" data-kid=\"34\">Phase 03</span>\n                        <h3 class=\"text-2xl font-plus font-bold text-[#1A202C]\" data-kid=\"35\">Audio Optimization</h3>\n                    </div>\n                    <p class=\"text-[#1A202C]/60 text-lg leading-relaxed max-w-2xl\" data-kid=\"36\">\n                        End-to-end stream optimization and noise cancellation to achieve sub-500ms latency for seamless real-time human-AI interaction.\n                    </p>\n                </div>\n\n                \n                <div class=\"phase-card p-4 rounded-xl\" data-kid=\"37\">\n                    <div class=\"flex items-baseline gap-4 mb-2\" data-kid=\"38\">\n                        <span class=\"font-plus text-xs font-bold text-[#319795] tracking-widest uppercase\" data-kid=\"39\">Phase 04</span>\n                        <h3 class=\"text-2xl font-plus font-bold text-[#1A202C]\" data-kid=\"40\">CRM & Calendar Tools</h3>\n                    </div>\n                    <p class=\"text-[#1A202C]/60 text-lg leading-relaxed max-w-2xl\" data-kid=\"41\">\n                        Full lifecycle management through seamless data synchronization with internal CRMs and automated lead booking via Cal.com.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    \n    <footer class=\"mt-auto flex justify-between items-center border-t border-[#F5F7FA] pt-8\" data-kid=\"42\">\n        <div class=\"flex gap-12\" data-kid=\"43\">\n            <div class=\"flex items-center gap-3\" data-kid=\"44\">\n                <span class=\"text-[10px] font-plus font-bold text-[#1A202C]/30 uppercase tracking-widest\" data-kid=\"45\">Client</span>\n                <span class=\"text-sm font-inter text-[#1A202C]/60\" data-kid=\"46\">Technical Committee</span>\n            </div>\n            <div class=\"flex items-center gap-3\" data-kid=\"47\">\n                <span class=\"text-[10px] font-plus font-bold text-[#1A202C]/30 uppercase tracking-widest\" data-kid=\"48\">Timeline</span>\n                <span class=\"text-sm font-inter text-[#1A202C]/60\" data-kid=\"49\">Q3 - Q4 2024</span>\n            </div>\n        </div>\n        <div class=\"text-[10px] font-plus font-bold text-[#1A202C]/20 uppercase tracking-[0.3em]\" data-kid=\"50\">\n            Outbound AI / Confidential\n        </div>\n    </footer>\n\n</div>\n",
