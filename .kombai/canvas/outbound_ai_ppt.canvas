      "html": "\n<div class=\"w-[1280px] min-h-[800px] bg-white text-[#1A202C] font-['Inter'] relative overflow-hidden flex flex-col\" data-kid=\"0\">\n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Inter:wght@400;500;600;700&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        .font-dm { font-family: 'DM Sans', sans-serif; }\n        .font-inter { font-family: 'Inter', sans-serif; }\n\n        .next-step-card:hover .icon-container {\n            transform: scale(1.05);\n            border-color: #319795;\n            background-color: #F0FDFA;\n        }\n\n        .icon-container {\n            transition: all 0.3s ease;\n        }\n    </style>\n\n    \n    <div class=\"px-16 pt-12 pb-8 flex justify-between items-center relative z-50\" data-kid=\"3\">\n        <div class=\"flex items-center gap-3\" data-kid=\"4\">\n            <div class=\"w-8 h-8 bg-[#319795] rounded-sm flex items-center justify-center\" data-kid=\"5\">\n                <i class=\"ti ti-rocket text-white text-lg\" data-kid=\"2\"></i>\n            </div>\n            <span class=\"font-dm font-bold text-xl tracking-tight uppercase\" data-kid=\"6\">Outbound<span class=\"text-[#319795]\" data-kid=\"7\">AI</span></span>\n        </div>\n        <div class=\"text-[#A0AEC0] font-mono text-xs tracking-widest uppercase\" data-kid=\"8\">Slide 07 // Future Scope</div>\n    </div>\n\n    \n    <div class=\"flex-grow flex flex-col items-center justify-center px-16 relative z-10\" data-kid=\"9\">\n        \n        <div class=\"text-center mb-20 max-w-3xl\" data-kid=\"10\">\n            <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#F5F7FA] border border-[#E2E8F0] mb-6\" data-kid=\"11\">\n                <span class=\"w-2 h-2 rounded-full bg-[#319795] animate-pulse\" data-kid=\"62\"></span>\n                <span class=\"text-[10px] font-bold tracking-widest uppercase text-[#718096]\" data-kid=\"63\">Roadmap 2025-2026</span>\n            </div>\n            <h2 class=\"text-6xl font-dm font-bold mb-6 tracking-tight text-[#1A202C]\" data-kid=\"12\">\n                The Next <span class=\"text-[#319795]\" data-kid=\"64\">Frontier</span>\n            </h2>\n            <p class=\"text-xl text-[#718096] font-medium leading-relaxed font-inter\" data-kid=\"13\">\n                Scaling our cognitive ecosystem to break language barriers and understand the deep emotional nuances of every conversation.\n            </p>\n        </div>\n\n        <div class=\"grid grid-cols-3 gap-16 w-full max-w-5xl\" data-kid=\"14\">\n            \n            <div class=\"next-step-card flex flex-col items-center text-center group\" data-kid=\"15\">\n                <div class=\"icon-container w-16 h-16 rounded-2xl bg-[#F5F7FA] flex items-center justify-center mb-8 border border-[#E2E8F0] shadow-xs\" data-kid=\"16\">\n                    <i class=\"ti ti-mood-puzzled text-3xl text-[#319795]\" data-kid=\"17\"></i>\n                </div>\n                <h3 class=\"text-2xl font-dm font-bold mb-4 text-[#1A202C]\" data-kid=\"18\">Emotion Analytics</h3>\n                <p class=\"text-[#718096] leading-relaxed text-[15px] font-inter\" data-kid=\"19\">\n                    Cognitive analysis of pitch and tone to identify buyer hesitation or excitement in real-time.\n                </p>\n            </div>\n\n            \n            <div class=\"next-step-card flex flex-col items-center text-center group\" data-kid=\"20\">\n                <div class=\"icon-container w-16 h-16 rounded-2xl bg-[#F5F7FA] flex items-center justify-center mb-8 border border-[#E2E8F0] shadow-xs\" data-kid=\"21\">\n                    <i class=\"ti ti-language-hiragana text-3xl text-[#319795]\" data-kid=\"22\"></i>\n                </div>\n                <h3 class=\"text-2xl font-dm font-bold mb-4 text-[#1A202C]\" data-kid=\"23\">Multilingual Support</h3>\n                <p class=\"text-[#718096] leading-relaxed text-[15px] font-inter\" data-kid=\"24\">\n                    Native-grade fluency with dialect-specific cultural nuances for seamless global expansion.\n                </p>\n            </div>\n\n            \n            <div class=\"next-step-card flex flex-col items-center text-center group\" data-kid=\"25\">\n                <div class=\"icon-container w-16 h-16 rounded-2xl bg-[#F5F7FA] flex items-center justify-center mb-8 border border-[#E2E8F0] shadow-xs\" data-kid=\"26\">\n                    <i class=\"ti ti-brain text-3xl text-[#319795]\" data-kid=\"27\"></i>\n                </div>\n                <h3 class=\"text-2xl font-dm font-bold mb-4 text-[#1A202C]\" data-kid=\"28\">Agent Autonomy</h3>\n                <p class=\"text-[#718096] leading-relaxed text-[15px] font-inter\" data-kid=\"29\">\n                    Self-improving agents that learn from top-performing human closers via feedback loops.\n                </p>\n            </div>\n        </div>\n    </div>\n\n    \n    <div class=\"px-16 pb-12 pt-8 border-t border-[#F5F7FA] relative z-20 flex justify-between items-end\" data-kid=\"30\">\n        <div class=\"flex gap-16\" data-kid=\"31\">\n            \n            <div class=\"flex items-center gap-4 group cursor-default\" data-kid=\"32\">\n                <div class=\"relative\" data-kid=\"33\">\n                    <img src=\"https://i.pravatar.cc/150?u=alex_outbound\" class=\"w-12 h-12 rounded-full border-2 border-white shadow-sm transition-transform group-hover:scale-105\" alt=\"Alex Chen\" decoding=\"async\" loading=\"lazy\" data-kid=\"34\" >\n                    <div class=\"absolute -bottom-1 -right-1 w-4 h-4 bg-green-500 border-2 border-white rounded-full\" data-kid=\"35\"></div>\n                </div>\n                <div class=\"flex flex-col\" data-kid=\"36\">\n                    <span class=\"text-sm font-bold font-dm text-[#1A202C]\" data-kid=\"37\">Alex Chen</span>\n                    <span class=\"text-[11px] font-medium text-[#A0AEC0] uppercase tracking-wider\" data-kid=\"38\">Lead AI Engineer</span>\n                </div>\n            </div>\n            \n            <div class=\"flex items-center gap-4 group cursor-default\" data-kid=\"39\">\n                <div class=\"relative\" data-kid=\"40\">\n                    <img src=\"https://i.pravatar.cc/150?u=sarah_outbound\" class=\"w-12 h-12 rounded-full border-2 border-white shadow-sm transition-transform group-hover:scale-105\" alt=\"Sarah Miller\" decoding=\"async\" loading=\"lazy\" data-kid=\"41\" >\n                    <div class=\"absolute -bottom-1 -right-1 w-4 h-4 bg-green-500 border-2 border-white rounded-full\" data-kid=\"42\"></div>\n                </div>\n                <div class=\"flex flex-col\" data-kid=\"43\">\n                    <span class=\"text-sm font-bold font-dm text-[#1A202C]\" data-kid=\"44\">Sarah Miller</span>\n                    <span class=\"text-[11px] font-medium text-[#A0AEC0] uppercase tracking-wider\" data-kid=\"45\">Product Strategist</span>\n                </div>\n            </div>\n            \n            <div class=\"flex items-center gap-4 group cursor-default\" data-kid=\"46\">\n                <div class=\"relative\" data-kid=\"47\">\n                    <img src=\"https://i.pravatar.cc/150?u=david_outbound\" class=\"w-12 h-12 rounded-full border-2 border-white shadow-sm transition-transform group-hover:scale-105\" alt=\"David K.\" decoding=\"async\" loading=\"lazy\" data-kid=\"48\" >\n                    <div class=\"absolute -bottom-1 -right-1 w-4 h-4 bg-[#319795] border-2 border-white rounded-full\" data-kid=\"49\"></div>\n                </div>\n                <div class=\"flex flex-col\" data-kid=\"50\">\n                    <span class=\"text-sm font-bold font-dm text-[#1A202C]\" data-kid=\"51\">David K.</span>\n                    <span class=\"text-[11px] font-medium text-[#A0AEC0] uppercase tracking-wider\" data-kid=\"52\">UX Architect</span>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"flex items-center gap-6\" data-kid=\"53\">\n            <div class=\"text-right\" data-kid=\"54\">\n                <p class=\"text-[10px] text-[#A0AEC0] uppercase tracking-[0.2em] mb-1 font-bold\" data-kid=\"55\">Version</p>\n                <p class=\"text-sm font-dm font-bold text-[#1A202C]\" data-kid=\"56\">1.0.4-LATEST</p>\n            </div>\n            <div class=\"w-px h-8 bg-[#E2E8F0]\" data-kid=\"57\"></div>\n            <div class=\"text-right\" data-kid=\"58\">\n                <p class=\"text-[10px] text-[#A0AEC0] uppercase tracking-[0.2em] mb-1 font-bold\" data-kid=\"59\">Project</p>\n                <p class=\"text-sm font-dm font-bold text-[#319795]\" data-kid=\"60\">OUTBOUND_AI</p>\n            </div>\n        </div>\n    </div>\n\n    \n    <div class=\"absolute top-0 right-0 w-[400px] h-[400px] opacity-[0.03] pointer-events-none\" data-kid=\"61\">\n        <svg viewBox=\"0 0 100 100\" class=\"w-full h-full text-[#1A202C]\" data-kid=\"65\">\n            <pattern id=\"grid\" width=\"10\" height=\"10\" patternUnits=\"userSpaceOnUse\" data-kid=\"66\">\n                <path d=\"M 10 0 L 0 0 0 10\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"0.5\" data-kid=\"67\"></path>\n            </pattern>\n            <rect width=\"100\" height=\"100\" fill=\"url(#grid)\" data-kid=\"68\"></rect>\n        </svg>\n    </div>\n</div>\n",
