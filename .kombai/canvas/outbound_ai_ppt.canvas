      },
      "html": "\n<section class=\"relative bg-white text-[#1A202C] min-h-[800px] w-full overflow-hidden flex font-['Inter'] select-none\" data-kid=\"0\">\n    \n    \n    <div class=\"absolute inset-0 pointer-events-none overflow-hidden opacity-[0.03]\" data-kid=\"1\">\n        <div class=\"absolute top-0 right-0 w-[800px] h-[800px]\" data-kid=\"2\">\n            <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/windy-stripes.svg\" class=\"w-full h-full object-cover\" style=\"color: #319795;\" decoding=\"async\" loading=\"lazy\" data-kid=\"3\">\n        </div>\n    </div>\n\n    \n    <div class=\"relative z-10 w-full flex flex-row\" data-kid=\"4\">\n        \n        \n        <div class=\"w-2/5 flex flex-col justify-center px-16 lg:px-24\" data-kid=\"5\">\n            <div class=\"space-y-12\" data-kid=\"6\">\n                \n                <div class=\"flex items-center gap-3\" data-kid=\"7\">\n                    <span class=\"w-12 h-[1px] bg-[#319795]\" data-kid=\"8\"></span>\n                    <span class=\"text-[10px] font-bold uppercase tracking-[0.3em] text-[#319795]/80 font-['DM_Sans']\" data-kid=\"9\">\n                        Problem Definition — 02\n                    </span>\n                </div>\n\n                \n                <div class=\"relative\" data-kid=\"10\">\n                    <h1 class=\"text-7xl xl:text-8xl font-black leading-[0.95] tracking-tighter text-[#1A202C]\" data-kid=\"11\">\n                        Manual <br data-kid=\"12\">\n                        calling <br data-kid=\"13\">\n                        is <br data-kid=\"14\">\n                        <span class=\"text-[#319795]\" data-kid=\"15\">broken.</span>\n                    </h1>\n                </div>\n\n                \n                <p class=\"text-lg text-slate-500 font-['DM_Sans'] leading-relaxed max-w-sm\" data-kid=\"16\">\n                    Traditional outbound operations are hitting a wall of scalability, efficiency, and human fatigue.\n                </p>\n            </div>\n        </div>\n\n        \n        <div class=\"w-3/5 bg-[#F5F7FA] flex items-center justify-center p-16 lg:p-24\" data-kid=\"17\">\n            <div class=\"grid grid-cols-2 gap-6 w-full max-w-3xl\" data-kid=\"18\">\n                \n                \n                <div class=\"group bg-white rounded-2xl border border-slate-200 p-8 space-y-6 transition-all duration-500 hover:shadow-xl hover:shadow-[#319795]/5 hover:-translate-y-1\" data-kid=\"19\">\n                    <div class=\"flex justify-between items-start\" data-kid=\"20\">\n                        <div class=\"space-y-1\" data-kid=\"21\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-widest text-slate-400 font-['DM_Sans']\" data-kid=\"22\">Operational Overhead</p>\n                            <h3 class=\"text-4xl font-bold tracking-tighter text-[#1A202C]\" data-kid=\"23\">+142%</h3>\n                        </div>\n                        <div class=\"w-10 h-10 rounded-full bg-[#319795]/10 flex items-center justify-center\" data-kid=\"24\">\n                            <i class=\"ti ti-currency-dollar text-[#319795] text-xl\" data-kid=\"25\"></i>\n                        </div>\n                    </div>\n                    \n                    <div class=\"h-16 w-full\" data-kid=\"26\">\n                        <svg viewBox=\"0 0 100 40\" class=\"w-full h-full\" preserveAspectRatio=\"none\" data-kid=\"27\">\n                            <path d=\"M0 35 L 20 32 L 40 38 L 60 25 L 80 15 L 100 5\" fill=\"none\" stroke=\"#319795\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"28\"></path>\n                            <circle cx=\"100\" cy=\"5\" r=\"3\" fill=\"#319795\" data-kid=\"29\"></circle>\n                        </svg>\n                    </div>\n                    <p class=\"text-xs text-slate-400 font-['DM_Sans'] leading-tight\" data-kid=\"30\">\n                        Costs scale linearly with volume, making growth prohibitively expensive.\n                    </p>\n                </div>\n\n                \n                <div class=\"group bg-white rounded-2xl border border-slate-200 p-8 space-y-6 transition-all duration-500 hover:shadow-xl hover:shadow-[#319795]/5 hover:-translate-y-1\" data-kid=\"31\">\n                    <div class=\"flex justify-between items-start\" data-kid=\"32\">\n                        <div class=\"space-y-1\" data-kid=\"33\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-widest text-slate-400 font-['DM_Sans']\" data-kid=\"34\">Conversion Efficiency</p>\n                            <h3 class=\"text-4xl font-bold tracking-tighter text-[#1A202C]\" data-kid=\"35\">-44%</h3>\n                        </div>\n                        <div class=\"w-10 h-10 rounded-full bg-red-500/10 flex items-center justify-center\" data-kid=\"36\">\n                            <i class=\"ti ti-target-off text-red-500 text-xl\" data-kid=\"37\"></i>\n                        </div>\n                    </div>\n                    \n                    <div class=\"h-16 w-full\" data-kid=\"38\">\n                        <svg viewBox=\"0 0 100 40\" class=\"w-full h-full\" preserveAspectRatio=\"none\" data-kid=\"39\">\n                            <path d=\"M0 5 L 20 8 L 40 25 L 60 22 L 80 35 L 100 38\" fill=\"none\" stroke=\"#319795\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" opacity=\"0.4\" data-kid=\"40\"></path>\n                            <circle cx=\"100\" cy=\"38\" r=\"3\" fill=\"#319795\" opacity=\"0.4\" data-kid=\"41\"></circle>\n                        </svg>\n                    </div>\n                    <p class=\"text-xs text-slate-400 font-['DM_Sans'] leading-tight\" data-kid=\"42\">\n                        Manual fatigue leads to declining connection rates and lower quality conversations.\n                    </p>\n                </div>\n\n                \n                <div class=\"group bg-white rounded-2xl border border-slate-200 p-8 space-y-6 transition-all duration-500 hover:shadow-xl hover:shadow-[#319795]/5 hover:-translate-y-1\" data-kid=\"43\">\n                    <div class=\"flex justify-between items-start\" data-kid=\"44\">\n                        <div class=\"space-y-1\" data-kid=\"45\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-widest text-slate-400 font-['DM_Sans']\" data-kid=\"46\">Response Latency</p>\n                            <h3 class=\"text-4xl font-bold tracking-tighter text-[#1A202C]\" data-kid=\"47\">28m</h3>\n                        </div>\n                        <div class=\"w-10 h-10 rounded-full bg-amber-500/10 flex items-center justify-center\" data-kid=\"48\">\n                            <i class=\"ti ti-hourglass-empty text-amber-500 text-xl\" data-kid=\"49\"></i>\n                        </div>\n                    </div>\n                    \n                    <div class=\"h-16 w-full\" data-kid=\"50\">\n                        <svg viewBox=\"0 0 100 40\" class=\"w-full h-full\" preserveAspectRatio=\"none\" data-kid=\"51\">\n                            <path d=\"M0 38 L 20 35 L 40 20 L 60 15 L 80 8 L 100 5\" fill=\"none\" stroke=\"#319795\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"52\"></path>\n                            <circle cx=\"100\" cy=\"5\" r=\"3\" fill=\"#319795\" data-kid=\"53\"></circle>\n                        </svg>\n                    </div>\n                    <p class=\"text-xs text-slate-400 font-['DM_Sans'] leading-tight\" data-kid=\"54\">\n                        Golden window (5 min) missed in 85% of cases due to manual limitations.\n                    </p>\n                </div>\n\n                \n                <div class=\"group bg-white rounded-2xl border border-slate-200 p-8 space-y-6 transition-all duration-500 hover:shadow-xl hover:shadow-[#319795]/5 hover:-translate-y-1\" data-kid=\"55\">\n                    <div class=\"flex justify-between items-start\" data-kid=\"56\">\n                        <div class=\"space-y-1\" data-kid=\"57\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-widest text-slate-400 font-['DM_Sans']\" data-kid=\"58\">Annual Attrition</p>\n                            <h3 class=\"text-4xl font-bold tracking-tighter text-[#1A202C]\" data-kid=\"59\">68%</h3>\n                        </div>\n                        <div class=\"w-10 h-10 rounded-full bg-[#319795]/10 flex items-center justify-center\" data-kid=\"60\">\n                            <i class=\"ti ti-users-minus text-[#319795] text-xl\" data-kid=\"61\"></i>\n                        </div>\n                    </div>\n                    \n                    <div class=\"h-16 w-full\" data-kid=\"62\">\n                        <svg viewBox=\"0 0 100 40\" class=\"w-full h-full\" preserveAspectRatio=\"none\" data-kid=\"63\">\n                            <path d=\"M0 30 L 25 32 L 50 20 L 75 10 L 100 5\" fill=\"none\" stroke=\"#319795\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"64\"></path>\n                            <circle cx=\"100\" cy=\"5\" r=\"3\" fill=\"#319795\" data-kid=\"65\"></circle>\n                        </svg>\n                    </div>\n                    <p class=\"text-xs text-slate-400 font-['DM_Sans'] leading-tight\" data-kid=\"66\">\n                        High-stress repetitive tasks lead to massive turnover and constant retraining.\n                    </p>\n                </div>\n\n            </div>\n        </div>\n    </div>\n\n    \n    <div class=\"absolute bottom-10 left-16 lg:left-24 right-16 lg:right-24 flex justify-between items-end pointer-events-none z-20\" data-kid=\"67\">\n        <div class=\"text-[9px] font-black uppercase tracking-[0.4em] text-slate-300 font-['DM_Sans']\" data-kid=\"68\">\n            Hackathon Project / AI Outbound\n        </div>\n        <div class=\"flex gap-4\" data-kid=\"69\">\n            <div class=\"w-12 h-1 bg-[#1A202C]\" data-kid=\"70\"></div>\n            <div class=\"w-12 h-1 bg-slate-100\" data-kid=\"71\"></div>\n            <div class=\"w-12 h-1 bg-slate-100\" data-kid=\"72\"></div>\n            <div class=\"w-12 h-1 bg-slate-100\" data-kid=\"73\"></div>\n        </div>\n    </div>\n\n</section>\n\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"74\">\n\n<style data-kid=\"75\">\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=DM+Sans:wght@400;500;700&display=swap');\n\n/* Subtle Animation for entrance */\n@keyframes slideInUp {\n    from { opacity: 0; transform: translateY(20px); }\n    to { opacity: 1; transform: translateY(0); }\n}\n\n.animate-entrance {\n    animation: slideInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n\n/* Custom transitions */\n.transition-all {\n    transition-property: all;\n    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n    transition-duration: 300ms;\n}\n</style>\n",
