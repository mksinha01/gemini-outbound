      "html": "\n<section id=\"outbound-ai-title-slide\" class=\"relative w-full h-[800px] bg-white overflow-hidden flex flex-col font-sans text-[#1A202C]\" data-kid=\"0\">\n    \n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=IBM+Plex+Sans:wght@400;500;600&family=Inter:wght@400;500;600&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        .font-jakarta { font-family: 'Plus Jakarta Sans', sans-serif; }\n        .font-plex { font-family: 'IBM Plex Sans', sans-serif; }\n        .font-inter { font-family: 'Inter', sans-serif; }\n\n        .diagonal-stripes {\n            background-image: repeating-linear-gradient(45deg, #1A202C 0, #1A202C 1px, transparent 0, transparent 50%);\n            background-size: 14px 14px;\n        }\n\n        .hairline-border {\n            border: 1px solid rgba(26, 32, 44, 0.08);\n        }\n    </style>\n\n    \n    <div class=\"absolute top-0 right-0 w-[500px] h-[500px] diagonal-stripes opacity-[0.03] pointer-events-none\" data-kid=\"2\"></div>\n    \n    \n    <div class=\"absolute top-16 left-20 flex items-center gap-6\" data-kid=\"3\">\n        <div class=\"flex items-center gap-3\" data-kid=\"4\">\n            <div class=\"w-10 h-10 rounded-xl bg-[#F5F7FA] hairline-border flex items-center justify-center\" data-kid=\"5\">\n                <i class=\"ti ti-cpu text-[#319795] text-xl\" data-kid=\"6\"></i>\n            </div>\n            <div class=\"flex flex-col\" data-kid=\"7\">\n                <span class=\"text-[10px] font-jakarta font-bold uppercase tracking-[0.2em] text-[#1A202C]/40\" data-kid=\"8\">Project Outline</span>\n                <span class=\"text-xs font-plex font-semibold text-[#1A202C]\" data-kid=\"9\">Slide 01 / 12</span>\n            </div>\n        </div>\n        <div class=\"h-8 w-[1px] bg-[#1A202C]/10\" data-kid=\"10\"></div>\n        <div class=\"flex flex-col\" data-kid=\"11\">\n            <span class=\"text-[10px] font-jakarta font-bold uppercase tracking-[0.2em] text-[#1A202C]/40\" data-kid=\"12\">Conference</span>\n            <span class=\"text-xs font-plex font-semibold text-[#1A202C]\" data-kid=\"13\">Tech Hackathon 2024</span>\n        </div>\n    </div>\n\n    \n    <div class=\"mt-auto pl-20 pb-24 flex flex-col items-start\" data-kid=\"14\">\n        \n        \n        <div class=\"flex items-center gap-4 mb-6\" data-kid=\"15\">\n            <div class=\"w-1 h-6 bg-[#319795]\" data-kid=\"16\"></div>\n            <p class=\"text-xs font-jakarta font-bold uppercase tracking-[0.3em] text-[#319795]\" data-kid=\"17\">\n                Innovative Outbound Solutions\n            </p>\n        </div>\n\n        \n        <h1 class=\"text-[160px] font-jakarta font-extrabold leading-[0.85] tracking-tighter text-[#1A202C] mb-8\" data-kid=\"18\">\n            OutboundAI\n        </h1>\n\n        \n        <div class=\"flex flex-col gap-2 max-w-2xl\" data-kid=\"19\">\n            <p class=\"text-2xl font-plex font-normal text-[#1A202C]/60 leading-snug\" data-kid=\"20\">\n                Automated AI Outbound Calling\n            </p>\n            <div class=\"flex items-center gap-3\" data-kid=\"21\">\n                <span class=\"text-sm font-jakarta font-bold uppercase tracking-widest text-[#1A202C]/30\" data-kid=\"22\">Engineered with</span>\n                <span class=\"px-3 py-1 rounded-full bg-[#F5F7FA] hairline-border text-xs font-plex font-bold text-[#319795]\" data-kid=\"23\">Gemini</span>\n                <span class=\"text-[#1A202C]/20\" data-kid=\"24\">&</span>\n                <span class=\"px-3 py-1 rounded-full bg-[#F5F7FA] hairline-border text-xs font-plex font-bold text-[#319795]\" data-kid=\"25\">LiveKit</span>\n            </div>\n        </div>\n\n        \n        <div class=\"mt-16 w-32 h-[2px] bg-[#319795]/20\" data-kid=\"26\"></div>\n    </div>\n\n    \n    <div class=\"absolute bottom-10 right-20 flex items-center gap-8\" data-kid=\"27\">\n        <div class=\"flex flex-col items-end\" data-kid=\"28\">\n            <span class=\"text-[9px] font-jakarta font-bold uppercase tracking-[0.3em] text-[#1A202C]/30\" data-kid=\"29\">Availability</span>\n            <div class=\"flex items-center gap-2\" data-kid=\"30\">\n                <div class=\"w-1.5 h-1.5 rounded-full bg-[#319795]\" data-kid=\"31\"></div>\n                <span class=\"text-[11px] font-plex font-bold text-[#1A202C]/60\" data-kid=\"32\">Systems Operational</span>\n            </div>\n        </div>\n        <div class=\"h-10 w-[1px] bg-[#1A202C]/10\" data-kid=\"33\"></div>\n        <div class=\"text-[10px] font-plex text-[#1A202C]/40 text-right leading-tight\" data-kid=\"34\">\n            CONFIDENTIAL<br data-kid=\"35\">Q3 RELEASE v1.0.4\n        </div>\n    </div>\n\n</section>\n",
