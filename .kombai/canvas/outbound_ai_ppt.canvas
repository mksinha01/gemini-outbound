      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=DM+Sans:wght@400;500;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --color-bg: #F5F7FA;\n    --color-card: #FFFFFF;\n    --color-text: #1A202C;\n    --color-accent: #319795;\n    --color-border: #D0D0CC;\n  }\n\n  .font-heading { font-family: 'Inter', sans-serif; }\n  .font-body { font-family: 'DM Sans', sans-serif; }\n\n  .hairline-border {\n    border: 1px solid var(--color-border);\n    border-radius: 14px;\n  }\n\n  .browser-chrome {\n    border-top: 1px solid var(--color-border);\n    border-left: 1px solid var(--color-border);\n    border-right: 1px solid var(--color-border);\n    border-top-left-radius: 12px;\n    border-top-right-radius: 12px;\n    background: #FFFFFF;\n  }\n\n  .dot {\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n  }\n\n  .shadow-soft {\n    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);\n  }\n\n  .bento-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    grid-template-rows: repeat(2, 1fr);\n    gap: 1.5rem;\n  }\n</style>\n\n<div class=\"w-[1280px] h-[850px] bg-[var(--color-bg)] text-[var(--color-text)] font-body p-16 flex flex-col relative overflow-hidden\" data-kid=\"1\">\n  \n  \n  <div class=\"absolute top-0 right-0 w-96 h-96 opacity-[0.03] pointer-events-none\" data-kid=\"2\">\n    <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/windy-stripes.svg\" class=\"w-full h-full rotate-45\" data-kid=\"3\">\n  </div>\n\n  \n  <div class=\"mb-12\" data-kid=\"4\">\n    <div class=\"flex items-center gap-3 mb-4\" data-kid=\"5\">\n      <div class=\"h-[1px] w-8 bg-[var(--color-accent)]\" data-kid=\"6\"></div>\n      <span class=\"text-[var(--color-accent)] font-bold tracking-[0.2em] uppercase text-xs\" data-kid=\"7\">Slide 03 // Proposed Solution</span>\n    </div>\n    <h1 class=\"text-5xl font-extrabold font-heading tracking-tight leading-tight\" data-kid=\"8\">\n      The Autonomous <span class=\"text-[var(--color-accent)]\" data-kid=\"9\">Voice Layer</span>\n    </h1>\n    <p class=\"text-slate-500 mt-4 text-lg max-w-2xl\" data-kid=\"10\">\n      A multimodal architecture designed for enterprise-grade voice interactions with sub-second latency and deep integration.\n    </p>\n  </div>\n\n  \n  <div class=\"grow bento-grid\" data-kid=\"11\">\n    \n    \n    <div class=\"hairline-border bg-white p-8 flex flex-col justify-between shadow-soft hover:shadow-md transition-shadow\" data-kid=\"12\">\n      <div data-kid=\"13\">\n        <div class=\"w-10 h-10 rounded-lg bg-[var(--color-accent)]/10 flex items-center justify-center mb-6\" data-kid=\"14\">\n          <i class=\"ti ti-cpu text-[var(--color-accent)] text-2xl\" data-kid=\"15\"></i>\n        </div>\n        <h3 class=\"text-xl font-bold font-heading mb-2\" data-kid=\"16\">Autonomous Sales Agents</h3>\n        <p class=\"text-sm text-slate-500 leading-relaxed\" data-kid=\"17\">\n          Native-audio reasoning agents that manage complex end-to-end sales conversations.\n        </p>\n      </div>\n      <div class=\"mt-4 pt-4 border-t border-slate-100\" data-kid=\"18\">\n        <span class=\"text-[10px] font-bold tracking-widest text-slate-400 uppercase\" data-kid=\"19\">Status: Production</span>\n      </div>\n    </div>\n\n    \n    <div class=\"col-span-2 row-span-2 flex flex-col\" data-kid=\"20\">\n      <div class=\"browser-chrome px-4 py-3 flex items-center gap-2 bg-slate-50/50\" data-kid=\"21\">\n        <div class=\"dot bg-[#FF5F56]\" data-kid=\"22\"></div>\n        <div class=\"dot bg-[#FFBD2E]\" data-kid=\"23\"></div>\n        <div class=\"dot bg-[#27C93F]\" data-kid=\"24\"></div>\n        <div class=\"ml-4 h-6 bg-white border border-[var(--color-border)] rounded px-3 flex items-center grow\" data-kid=\"25\">\n          <span class=\"text-[10px] text-slate-400 font-mono\" data-kid=\"26\">outbound.ai/orchestrator/v1</span>\n        </div>\n        <div class=\"ml-2\" data-kid=\"27\">\n          <i class=\"ti ti-share text-slate-400 text-sm\" data-kid=\"28\"></i>\n        </div>\n      </div>\n      <div class=\"grow hairline-border !rounded-t-none bg-white overflow-hidden shadow-soft relative\" data-kid=\"29\">\n        <img src=\"https://images.pexels.com/photos/35262608/pexels-photo-35262608.jpeg?auto=compress&cs=tinysrgb&w=1000&q=80\" alt=\"Dashboard UI\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"30\">\n        \n        <div class=\"absolute bottom-6 left-6 right-6 bg-white/90 backdrop-blur-md p-4 hairline-border flex items-center justify-between\" data-kid=\"31\">\n          <div class=\"flex items-center gap-3\" data-kid=\"32\">\n            <div class=\"w-2 h-2 rounded-full bg-[var(--color-accent)] animate-pulse\" data-kid=\"33\"></div>\n            <span class=\"text-sm font-semibold\" data-kid=\"34\">Real-time Agent Monitoring</span>\n          </div>\n          <span class=\"text-xs text-slate-500 font-mono\" data-kid=\"35\">ID: AI_VOX_882</span>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"hairline-border bg-white p-8 flex flex-col justify-between shadow-soft hover:shadow-md transition-shadow\" data-kid=\"36\">\n      <div data-kid=\"37\">\n        <div class=\"w-10 h-10 rounded-lg bg-[var(--color-accent)]/10 flex items-center justify-center mb-6\" data-kid=\"38\">\n          <i class=\"ti ti-zap text-[var(--color-accent)] text-2xl\" data-kid=\"39\"></i>\n        </div>\n        <h3 class=\"text-xl font-bold font-heading mb-2\" data-kid=\"40\">Real-time Latency <span class=\"text-[var(--color-accent)]\" data-kid=\"41\">&lt; 500ms</span></h3>\n        <p class=\"text-sm text-slate-500 leading-relaxed\" data-kid=\"42\">\n          Optimized LiveKit + SIP stack ensures human-parity response times for seamless flow.\n        </p>\n      </div>\n      <div class=\"flex items-end gap-1\" data-kid=\"43\">\n        <div class=\"w-1 h-3 bg-[var(--color-accent)] rounded-full\" data-kid=\"44\"></div>\n        <div class=\"w-1 h-5 bg-[var(--color-accent)] rounded-full\" data-kid=\"45\"></div>\n        <div class=\"w-1 h-8 bg-[var(--color-accent)] rounded-full\" data-kid=\"46\"></div>\n        <div class=\"w-1 h-6 bg-[var(--color-accent)] rounded-full\" data-kid=\"47\"></div>\n        <div class=\"w-1 h-4 bg-[var(--color-accent)] rounded-full\" data-kid=\"48\"></div>\n      </div>\n    </div>\n\n    \n    <div class=\"hairline-border bg-white p-8 flex flex-col justify-between shadow-soft hover:shadow-md transition-shadow\" data-kid=\"49\">\n      <div data-kid=\"50\">\n        <div class=\"w-10 h-10 rounded-lg bg-[var(--color-accent)]/10 flex items-center justify-center mb-6\" data-kid=\"51\">\n          <i class=\"ti ti-database text-[var(--color-accent)] text-2xl\" data-kid=\"52\"></i>\n        </div>\n        <h3 class=\"text-xl font-bold font-heading mb-2\" data-kid=\"53\">Seamless CRM Sync</h3>\n        <p class=\"text-sm text-slate-500 leading-relaxed\" data-kid=\"54\">\n          Automatic lead qualification and direct write-back to Salesforce and HubSpot.\n        </p>\n      </div>\n      <div class=\"flex items-center gap-2\" data-kid=\"55\">\n        <div class=\"px-2 py-1 bg-slate-100 rounded text-[9px] font-bold text-slate-500 uppercase\" data-kid=\"56\">SFDC</div>\n        <div class=\"px-2 py-1 bg-slate-100 rounded text-[9px] font-bold text-slate-500 uppercase\" data-kid=\"57\">HS</div>\n      </div>\n    </div>\n\n    \n    <div class=\"hairline-border bg-white p-8 flex flex-col justify-between shadow-soft hover:shadow-md transition-shadow\" data-kid=\"58\">\n      <div data-kid=\"59\">\n        <div class=\"w-10 h-10 rounded-lg bg-[var(--color-accent)]/10 flex items-center justify-center mb-6\" data-kid=\"60\">\n          <i class=\"ti ti-calendar-event text-[var(--color-accent)] text-2xl\" data-kid=\"61\"></i>\n        </div>\n        <h3 class=\"text-xl font-bold font-heading mb-2\" data-kid=\"62\">Direct Booking</h3>\n        <p class=\"text-sm text-slate-500 leading-relaxed\" data-kid=\"63\">\n          Intelligent tool-calling capabilities to schedule appointments during the call.\n        </p>\n      </div>\n      <span class=\"text-xs text-[var(--color-accent)] font-semibold flex items-center gap-1\" data-kid=\"64\">\n        CAL.COM INTEGRATED <i class=\"ti ti-arrow-right\" data-kid=\"65\"></i>\n      </span>\n    </div>\n\n  </div>\n\n  \n  <div class=\"mt-12 flex items-center justify-between opacity-50\" data-kid=\"66\">\n    <div class=\"flex items-center gap-4\" data-kid=\"67\">\n      <span class=\"text-xs font-bold tracking-widest text-slate-400 uppercase\" data-kid=\"68\">Proprietary Architecture</span>\n      <div class=\"w-1.5 h-1.5 rounded-full bg-slate-300\" data-kid=\"69\"></div>\n      <span class=\"text-xs font-bold tracking-widest text-slate-400 uppercase\" data-kid=\"70\">Draft v2.4</span>\n    </div>\n    <div class=\"text-2xl font-black font-heading tracking-tighter\" data-kid=\"71\">\n      OUTBOUND<span class=\"text-[var(--color-accent)]\" data-kid=\"72\">AI</span>\n    </div>\n  </div>\n</div>\n",
