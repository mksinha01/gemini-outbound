      "html": "\n<body class=\"bg-white text-[#1A202C] font-['Inter'] m-0 p-0 overflow-hidden select-none\">\n  <style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=DM+Sans:wght@400;500;700&display=swap');\n\n    :root {\n      --slate-black: #1A202C;\n      --subtle-teal: #319795;\n      --soft-grey: #F5F7FA;\n    }\n\n    .font-dm { font-family: 'DM Sans', sans-serif; }\n    \n    .hero-stat-number {\n      font-size: 240px;\n      line-height: 0.85;\n      letter-spacing: -0.06em;\n      font-weight: 900;\n    }\n\n    .side-stat-number {\n      font-size: 96px;\n      line-height: 1;\n      letter-spacing: -0.04em;\n      font-weight: 800;\n    }\n\n    .hairline-border {\n      border: 1px solid #e2e8f0;\n    }\n\n    /* Subtle texture from inspiration */\n    .bg-stripes {\n      background-image: linear-gradient(135deg, #f0f4f8 10%, transparent 10%, transparent 50%, #f0f4f8 50%, #f0f4f8 60%, transparent 60%, transparent 100%);\n      background-size: 10px 10px;\n      opacity: 0.3;\n    }\n  </style>\n\n  <main class=\"relative w-[1280px] h-[800px] flex flex-col p-16 overflow-hidden\" data-kid=\"1\">\n    \n    \n    <div class=\"absolute top-0 right-0 w-64 h-64 bg-stripes pointer-events-none\" data-kid=\"2\"></div>\n\n    \n    <nav class=\"relative z-10 flex items-center justify-between mb-16\" data-kid=\"3\">\n      <div class=\"flex items-center gap-4\" data-kid=\"4\">\n        <div class=\"w-10 h-[2px] bg-[var(--subtle-teal)]\" data-kid=\"5\"></div>\n        <span class=\"text-[10px] font-black tracking-[0.4em] uppercase text-gray-400\" data-kid=\"6\">Slide 06 // ROI Analysis</span>\n      </div>\n      <div class=\"text-[10px] font-bold text-gray-300 tracking-widest uppercase\" data-kid=\"7\">Proprietary AI Voice Architecture</div>\n    </nav>\n\n    \n    <header class=\"relative z-10 mb-20 max-w-4xl\" data-kid=\"8\">\n      <h1 class=\"text-7xl font-black tracking-tighter uppercase leading-none\" data-kid=\"9\">\n        Expected <span class=\"text-[var(--subtle-teal)]\" data-kid=\"10\">Impact</span>\n      </h1>\n      <p class=\"mt-6 text-lg font-dm text-gray-500 max-w-xl leading-relaxed\" data-kid=\"11\">\n        Quantifiable performance gains and cost efficiencies realized through our low-latency AI voice integration.\n      </p>\n    </header>\n\n    \n    <div class=\"relative z-10 grid grid-cols-12 gap-6 items-end grow mb-12\" data-kid=\"12\">\n      \n      \n      <div class=\"col-span-3 flex flex-col\" data-kid=\"13\">\n        <div class=\"bg-[var(--soft-grey)] p-10 rounded-3xl hairline-border h-full flex flex-col justify-between aspect-square group transition-all hover:shadow-xl hover:-translate-y-1\" data-kid=\"14\">\n          <div class=\"flex justify-between items-start mb-4\" data-kid=\"15\">\n             <i class=\"ti ti-trending-down text-3xl text-[var(--subtle-teal)] opacity-50\" data-kid=\"16\"></i>\n             <span class=\"text-[10px] font-black bg-white px-2 py-1 rounded hairline-border text-gray-400\" data-kid=\"17\">KPI 01</span>\n          </div>\n          <div data-kid=\"18\">\n            <div class=\"side-stat-number text-[var(--slate-black)] mb-2\" data-kid=\"19\">80%</div>\n            <div class=\"text-xs font-black uppercase tracking-[0.25em] text-gray-500 font-dm\" data-kid=\"20\">Lower<br data-kid=\"21\">Cost</div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"col-span-6 flex flex-col items-center justify-center text-center\" data-kid=\"22\">\n        <div class=\"relative\" data-kid=\"23\">\n          \n          <div class=\"absolute inset-0 blur-3xl bg-[var(--subtle-teal)] opacity-5 scale-150\" data-kid=\"24\"></div>\n          <div class=\"relative z-10 hero-stat-number text-[var(--subtle-teal)] drop-shadow-sm\" data-kid=\"25\">300%</div>\n        </div>\n        <div class=\"mt-8 text-3xl font-black uppercase tracking-[0.5em] text-[var(--slate-black)] relative\" data-kid=\"26\">\n          Call Throughput\n          <div class=\"absolute -bottom-6 left-1/2 -translate-x-1/2 w-24 h-1 bg-[var(--subtle-teal)]/20 rounded-full overflow-hidden\" data-kid=\"27\">\n            <div class=\"h-full w-2/3 bg-[var(--subtle-teal)] rounded-full\" data-kid=\"28\"></div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"col-span-3 flex flex-col\" data-kid=\"29\">\n        <div class=\"bg-[var(--soft-grey)] p-10 rounded-3xl hairline-border h-full flex flex-col justify-between aspect-square text-right group transition-all hover:shadow-xl hover:-translate-y-1\" data-kid=\"30\">\n          <div class=\"flex justify-between items-start mb-4 flex-row-reverse\" data-kid=\"31\">\n             <i class=\"ti ti-clock-check text-3xl text-[var(--subtle-teal)] opacity-50\" data-kid=\"32\"></i>\n             <span class=\"text-[10px] font-black bg-white px-2 py-1 rounded hairline-border text-gray-400\" data-kid=\"33\">KPI 02</span>\n          </div>\n          <div data-kid=\"34\">\n            <div class=\"side-stat-number text-[var(--slate-black)] mb-2\" data-kid=\"35\">24/7</div>\n            <div class=\"text-xs font-black uppercase tracking-[0.25em] text-gray-500 font-dm\" data-kid=\"36\">Always-on<br data-kid=\"37\">Availability</div>\n          </div>\n        </div>\n      </div>\n\n    </div>\n\n    \n    <footer class=\"relative z-10 border-t border-gray-100 pt-10 flex justify-between items-center\" data-kid=\"38\">\n      <div class=\"flex items-center gap-8\" data-kid=\"39\">\n        <div class=\"flex items-center gap-3\" data-kid=\"40\">\n          <div class=\"w-3 h-3 rounded-full bg-[var(--subtle-teal)]\" data-kid=\"41\"></div>\n          <span class=\"text-[10px] font-black uppercase tracking-widest text-gray-500\" data-kid=\"42\">Global Scale Capable</span>\n        </div>\n        <div class=\"flex items-center gap-3\" data-kid=\"43\">\n          <div class=\"w-3 h-3 rounded-full border border-gray-300\" data-kid=\"44\"></div>\n          <span class=\"text-[10px] font-black uppercase tracking-widest text-gray-400\" data-kid=\"45\">Enterprise Ready</span>\n        </div>\n      </div>\n      <div class=\"flex gap-12\" data-kid=\"46\">\n        <div class=\"text-right\" data-kid=\"47\">\n          <div class=\"text-[10px] font-bold text-gray-300 uppercase tracking-widest mb-1\" data-kid=\"48\">Efficiency</div>\n          <div class=\"h-1 w-16 bg-gray-100 rounded-full\" data-kid=\"49\">\n            <div class=\"h-full w-full bg-[var(--subtle-teal)] rounded-full opacity-80\" data-kid=\"50\"></div>\n          </div>\n        </div>\n        <div class=\"text-right\" data-kid=\"51\">\n          <div class=\"text-[10px] font-bold text-gray-300 uppercase tracking-widest mb-1\" data-kid=\"52\">Performance</div>\n          <div class=\"h-1 w-16 bg-gray-100 rounded-full\" data-kid=\"53\">\n            <div class=\"h-full w-[90%] bg-[var(--subtle-teal)] rounded-full opacity-80\" data-kid=\"54\"></div>\n          </div>\n        </div>\n      </div>\n    </footer>\n\n    \n    <div class=\"absolute bottom-0 left-0 w-1 h-32 bg-[var(--subtle-teal)] opacity-20\" data-kid=\"55\"></div>\n    <div class=\"absolute top-0 right-0 h-1 w-32 bg-[var(--subtle-teal)] opacity-20\" data-kid=\"56\"></div>\n\n  </main>\n  \n  <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"57\">\n</body>\n",
