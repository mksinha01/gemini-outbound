er border-white/5 rounded-[32px] p-10 shadow-2xl relative min-h-[600px] flex flex-col space-y-10 animate-in fade-in duration-500\" data-kid=\"152\">\n          \n          \n          <div class=\"relative group\" data-kid=\"153\">\n            <div class=\"absolute -inset-1 bg-gradient-to-r from-[#0FFFFF]/20 to-[#6C3082]/20 rounded-[28px] blur opacity-50 group-hover:opacity-100 transition duration-1000\" data-kid=\"154\"></div>\n            <div class=\"relative border-2 border-dashed border-white/10 bg-[#010B13] rounded-[24px] p-16 flex flex-col items-center justify-center text-center group/inner hover:border-[#0FFFFF]/40 transition-all cursor-pointer\" data-kid=\"155\">\n              <div class=\"w-20 h-20 rounded-full bg-white/5 flex items-center justify-center mb-6 group-hover/inner:scale-110 transition-transform duration-500 relative\" data-kid=\"156\">\n                <i class=\"ti ti-file-upload text-[#0FFFFF] text-4xl\" data-kid=\"157\"></i>\n                <div class=\"absolute inset-0 rounded-full border border-[#0FFFFF]/20 animate-ping\" data-kid=\"158\"></div>\n              </div>\n              <h3 class=\"font-['Sora'] text-xl font-bold text-white mb-3\" data-kid=\"159\">Upload Lead Database</h3>\n              <p class=\"text-[#64748B] text-sm max-w-sm mx-auto mb-4\" data-kid=\"160\">\n                Drag and drop your batch CSV file. System supports up to <span class=\"text-white font-bold\" data-kid=\"161\">5,000</span> concurrent rows.\n              </p>\n              <div class=\"text-[10px] text-[#64748B] font-mono mb-8 p-3 rounded-lg bg-white/5 border border-white/5\" data-kid=\"162\">\n                Expected: phone, lead_name, business_name, service_type\n              </div>\n              <div class=\"flex gap-4\" data-kid=\"163\">\n                <button class=\"bg-[#0FFFFF]/10 border border-[#0FFFFF]/20 px-6 py-2.5 rounded-xl text-[11px] font-bold text-[#0FFFFF] uppercase tracking-widest hover:bg-[#0FFFFF] hover:text-[#010B13] transition-all\" data-kid=\"164\">Browse Files</button>\n                <button class=\"bg-white/5 border border-white/10 px-6 py-2.5 rounded-xl text-[11px] font-bold text-[#64748B] uppercase tracking-widest hover:bg-white/10 hover:text-white transition-all\" data-kid=\"165\">Download Template</button>\n              </div>\n            </div>\n          </div>\n\n          \n          <div class=\"bg-white/2 rounded-3xl p-8 border border-white/5\" data-kid=\"166\">\n            <div class=\"flex items-center justify-between mb-6\" data-kid=\"167\">\n              <div data-kid=\"168\">\n                <h4 class=\"text-xs font-bold text-white uppercase tracking-widest mb-1\" data-kid=\"169\">Queue Status</h4>\n                <p class=\"text-[10px] text-[#64748B]\" data-kid=\"170\">Batch Processing Engine v1.08</p>\n              </div>\n              <div class=\"text-right\" data-kid=\"171\">\n                <div class=\"text-2xl font-['Sora'] font-extrabold text-[#0FFFFF]\" data-kid=\"172\">68%</div>\n                <div class=\"text-[10px] text-[#64748B] font-mono\" data-kid=\"173\">170 / 250 Dispatched</div>\n              </div>\n            </div>\n            \n            \n            <div class=\"w-full h-2 bg-white/5 rounded-full overflow-hidden mb-8 relative\" data-kid=\"174\">\n              <div class=\"h-full w-[68%] bg-gradient-to-r from-[#0FFFFF] to-[#6C3082] relative\" data-kid=\"175\">\n                <div class=\"absolute inset-0 bg-white/30 animate-[pulse_2s_infinite]\" data-kid=\"176\"></div>\n              </div>\n            </div>\n\n            \n            <div class=\"grid grid-cols-2 gap-4\" data-kid=\"177\">\n              <div class=\"flex items-center gap-4 p-4 rounded-2xl bg-white/2 border border-white/5\" data-kid=\"178\">\n                <div class=\"w-8 h-8 rounded-full bg-green-500/20 flex items-center justify-center shrink-0\" data-kid=\"179\">\n                  <i class=\"ti ti-check text-green-500 text-sm\" data-kid=\"180\"></i>\n                </div>\n                <div data-kid=\"181\">\n                  <span class=\"block text-[11px] font-bold text-white\" data-kid=\"182\">Validation</span>\n                  <span class=\"block text-[9px] text-green-500 uppercase tracking-tighter\" data-kid=\"183\">Verified</span>\n                </div>\n              </div>\n              \n              <div class=\"flex items-center gap-4 p-4 rounded-2xl bg-white/2 border border-white/5\" data-kid=\"184\">\n                <div class=\"w-8 h-8 rounded-full bg-green-500/20 flex items-center justify-center shrink-0\" data-kid=\"185\">\n                  <i class=\"ti ti-check text-green-500 text-sm\" data-kid=\"186\"></i>\n                </div>\n                <div data-kid=\"187\">\n                  <span class=\"block text-[11px] font-bold text-white\" data-kid=\"188\">SIP Allocation</span>\n                  <span class=\"block text-[9px] text-green-500 uppercase tracking-tighter\" data-kid=\"189\">Trunks Secured</span>\n                </div>\n              </div>\n              \n              <div class=\"flex items-center gap-4 p-4 rounded-2xl bg-[#0FFFFF]/5 border border-[#0FFFFF]/20 relative overflow-hidden group\" data-kid=\"190\">\n                <div class=\"w-8 h-8 rounded-full bg-[#0FFFFF]/10 flex items-center justify-center shrink-0\" data-kid=\"191\">\n                  <i class=\"ti ti-loader text-[#0FFFFF] animate-spin text-sm\" data-kid=\"192\"></i>\n                </div>\n                <div class=\"relative z-10\" data-kid=\"193\">\n                  <span class=\"block text-[11px] font-bold text-white\" data-kid=\"194\">Active Dispatch</span>\n                  <span class=\"block text-[9px] text-[#0FFFFF] uppercase tracking-tighter\" data-kid=\"195\">Real-time dial-out</span>\n                </div>\n                <div class=\"absolute right-3 top-1/2 -translate-y-1/2\" data-kid=\"196\">\n                   <span class=\"text-[10px] font-mono text-[#0FFFFF]\" data-kid=\"197\">14/m</span>\n                </div>\n              </div>\n              \n              <div class=\"flex items-center gap-4 p-4 rounded-2xl bg-white/2 border border-white/5 opacity-40\" data-kid=\"198\">\n                <div class=\"w-8 h-8 rounded-full bg-white/5 flex items-center justify-center shrink-0\" data-kid=\"199\">\n                  <i class=\"ti ti-cloud-check text-white/30 text-sm\" data-kid=\"200\"></i>\n                </div>\n                <div data-kid=\"201\">\n                  <span class=\"block text-[11px] font-bold text-white\" data-kid=\"202\">CRM Integration</span>\n                  <span class=\"block text-[9px] text-[#64748B] uppercase tracking-tighter\" data-kid=\"203\">Post-call processing</span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"flex justify-end gap-4\" data-kid=\"204\">\n            <button class=\"px-8 py-3 rounded-xl border border-[#ef4444]/20 text-[#ef4444] text-xs font-bold uppercase tracking-widest hover:bg-[#ef4444]/10 transition-all\" data-kid=\"205\">Abort Batch</button>\n            <button class=\"px-8 py-3 rounded-xl bg-white/5 border border-white/10 text-white text-xs font-bold uppercase tracking-widest hover:bg-white/10 transition-all\" data-kid=\"206\">Pause Stream</button>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  </main>\n\n  \n  <div id=\"toast\" class=\"absolute bottom-10 right-10 translate-y-20 opacity-0 transition-all duration-500 z-[100] glass p-4 rounded-2xl flex items-center gap-4 max-w-sm pointer-events-none\" data-kid=\"207\">\n    <div class=\"w-10 h-10 rounded-xl bg-green-500/20 flex items-center justify-center shrink-0\" data-kid=\"208\">\n      <i class=\"ti ti-check text-green-500 text-xl\" data-kid=\"209\"></i>\n    </div>\n    <div data-kid=\"210\">\n      <h5 class=\"text-sm font-bold text-white\" data-kid=\"211\">Dispatch Initiated</h5>\n      <p class=\"text-xs text-[#94A3B8]\" data-kid=\"212\">Single call protocol handoff successful. Dialing target...</p>\n    </div>\n  </div>\n\n  <script data-kid=\"213\">\n    function switchTab(type) {\n      const singleBtn = document.getElementById('tab-single-btn');\n      const batchBtn = document.getElementById('tab-batch-btn');\n      const singleView = document.getElementById('single-view');\n      const batchView = document.getElementById('batch-view');\n\n      if (type === 'single') {\n        singleBtn.classList.add('bg-[#0FFFFF]', 'text-[#010B13]', 'shadow-[0_0_15px_rgba(15,255,255,0.2)]');\n        singleBtn.classList.remove('text-[#64748B]');\n        batchBtn.classList.remove('bg-[#0FFFFF]', 'text-[#010B13]', 'shadow-[0_0_15px_rgba(15,255,255,0.2)]');\n        batchBtn.classList.add('text-[#64748B]');\n        \n        singleView.classList.remove('hide');\n        batchView.classList.add('hide');\n      } else {\n        batchBtn.classList.add('bg-[#0FFFFF]', 'text-[#010B13]', 'shadow-[0_0_15px_rgba(15,255,255,0.2)]');\n        batchBtn.classList.remove('text-[#64748B]');\n        singleBtn.classList.remove('bg-[#0FFFFF]', 'text-[#010B13]', 'shadow-[0_0_15px_rgba(15,255,255,0.2)]');\n        singleBtn.classList.add('text-[#64748B]');\n        \n        batchView.classList.remove('hide');\n        singleView.classList.add('hide');\n      }\n    }\n\n    function nextStep(step) {\n      // Hide all content\n      document.getElementById('step-1-content').classList.add('hide');\n      document.getElementById('step-2-content').classList.add('hide');\n      document.getElementById('step-3-content').classList.add('hide');\n      \n      // Remove active from all indicators\n      document.getElementById('step-1-indicator').classList.remove('step-active');\n      document.getElementById('step-2-indicator').classList.remove('step-active');\n      document.getElementById('step-3-indicator').classList.remove('step-active');\n      document.getElementById('step-1-indicator').classList.add('text-[#64748B]');\n      document.getElementById('step-2-indicator').classList.add('text-[#64748B]');\n      document.getElementById('step-3-indicator').classList.add('text-[#64748B]');\n\n      // Handle lines\n      const line1 = document.getElementById('step-1-line');\n      const line2 = document.getElementById('step-2-line');\n      \n      if (step === 1) {\n        line1.classList.remove('active');\n        line1.style.background = 'rgba(255, 255, 255, 0.08)';\n        line2.classList.remove('active');\n        line2.style.background = 'rgba(255, 255, 255, 0.08)';\n      } else if (step === 2) {\n        line1.classList.add('active');\n        line1.style.background = 'linear-gradient(90deg, #0FFFFF, rgba(255, 255, 255, 0.08))';\n        line2.classList.remove('active');\n        line2.style.background = 'rgba(255, 255, 255, 0.08)';\n      } else if (step === 3) {\n        line1.classList.add('active');\n        line1.style.background = '#0FFFFF';\n        line2.classList.add('active');\n        line2.style.background = 'linear-gradient(90deg, #0FFFFF, rgba(255, 255, 255, 0.08))';\n      }\n\n      // Show target content\n      document.getElementById('step-' + step + '-content').classList.remove('hide');\n      const indicator = document.getElementById('step-' + step + '-indicator');\n      indicator.classList.add('step-active');\n      indicator.classList.remove('text-[#64748B]');\n      \n      // Update shadows/glows for steps\n      indicator.querySelector('.w-10').classList.add('shadow-[0_0_10px_rgba(15, 255, 255, 0.2)]');\n    }\n\n    function dispatchFinished() {\n      const toast = document.getElementById('toast');\n      toast.classList.remove('translate-y-20', 'opacity-0');\n      toast.classList.add('translate-y-0', 'opacity-100');\n      \n      setTimeout(() => {\n        toast.classList.add('translate-y-20', 'opacity-0');\n        toast.classList.remove('translate-y-0', 'opacity-100');\n        // Reset to step 1\n        nextStep(1);\n      }, 5000);\n    }\n  </script>\n</div>\n",
