      "html": "\n<div class=\"bg-[#010B13] text-[#E2E8F0] font-['Archivo'] min-h-[900px] overflow-x-hidden relative\" data-kid=\"0\">\n  \n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Archivo:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    .cyber-grid {\n      background-image: linear-gradient(to right, rgba(15, 255, 255, 0.03) 1px, transparent 1px),\n                        linear-gradient(to bottom, rgba(15, 255, 255, 0.03) 1px, transparent 1px);\n      background-size: 40px 40px;\n    }\n\n    .scanning-line {\n      position: absolute;\n      width: 100%;\n      height: 2px;\n      background: linear-gradient(to right, transparent, #0FFFFF, transparent);\n      opacity: 0.1;\n      animation: scan 4s linear infinite;\n    }\n\n    @keyframes scan {\n      0% { top: 0; }\n      100% { top: 100%; }\n    }\n\n    .glow-cyan {\n      box-shadow: 0 0 20px rgba(15, 255, 255, 0.3), 0 0 40px rgba(15, 255, 255, 0.1);\n    }\n\n    .glass {\n      background: rgba(13, 17, 23, 0.7);\n      backdrop-filter: blur(20px);\n      border: 1px solid rgba(255, 255, 255, 0.08);\n      box-shadow: inset 0 0 20px rgba(255, 255, 255, 0.02);\n    }\n\n    .step-active {\n      color: #0FFFFF;\n      border-color: #0FFFFF;\n    }\n\n    .step-line {\n      height: 2px;\n      flex-grow: 1;\n      background: rgba(255, 255, 255, 0.08);\n      position: relative;\n      top: -12px;\n    }\n\n    .step-line.active {\n      background: linear-gradient(90deg, #0FFFFF, transparent);\n    }\n\n    input:focus, select:focus {\n      border-color: #0FFFFF !important;\n      box-shadow: 0 0 15px rgba(15, 255, 255, 0.2);\n      background: rgba(255, 255, 255, 0.08);\n    }\n\n    input:hover, select:hover {\n      border-color: rgba(15, 255, 255, 0.3);\n    }\n\n    .hide { display: none; }\n  </style>\n\n  \n  <div class=\"absolute inset-0 cyber-grid pointer-events-none opacity-50 z-0\" data-kid=\"2\"></div>\n  <div class=\"absolute -top-[100px] -left-[100px] w-[600px] h-[600px] bg-[#0FFFFF]/10 rounded-full blur-[120px] pointer-events-none z-0\" data-kid=\"3\"></div>\n  <div class=\"absolute bottom-[200px] -right-[100px] w-[600px] h-[600px] bg-[#6C3082]/15 rounded-full blur-[120px] pointer-events-none z-0\" data-kid=\"4\"></div>\n\n  \n  <header class=\"relative z-50 border-b border-white/5 bg-[#010B13]/80 backdrop-blur-md px-10 py-5 flex items-center justify-between\" data-kid=\"5\">\n    <div class=\"flex items-center gap-3\" data-kid=\"6\">\n      <div class=\"w-10 h-10 rounded-lg bg-gradient-to-br from-[#0FFFFF] to-[#6C3082] flex items-center justify-center shadow-[0_0_15px_rgba(15,255,255,0.2)]\" data-kid=\"7\">\n        <i class=\"ti ti-robot text-white text-xl\" data-kid=\"8\"></i>\n      </div>\n      <div data-kid=\"9\">\n        <h1 class=\"font-['Sora'] font-extrabold text-lg tracking-tight\" data-kid=\"10\">OUTBOUND<span class=\"text-[#0FFFFF]\" data-kid=\"11\">AI</span></h1>\n        <p class=\"text-[10px] text-[#64748B] font-bold uppercase tracking-widest leading-none\" data-kid=\"12\">Voice Intelligence Hub</p>\n      </div>\n    </div>\n    \n    <div class=\"flex items-center gap-6\" data-kid=\"13\">\n      <div class=\"flex items-center gap-2 px-3 py-1.5 rounded-full bg-green-500/10 border border-green-500/20\" data-kid=\"14\">\n        <div class=\"w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse\" data-kid=\"15\"></div>\n        <span class=\"text-[10px] font-bold text-green-500 uppercase tracking-wider\" data-kid=\"16\">SIP Node Active</span>\n      </div>\n      <div class=\"w-10 h-10 rounded-full border border-white/10 p-0.5\" data-kid=\"17\">\n        <img src=\"https://i.pravatar.cc/100?u=admin\" alt=\"User\" class=\"w-full h-full rounded-full grayscale opacity-80\" data-kid=\"18\">\n      </div>\n    </div>\n  </header>\n\n  <main class=\"relative z-10 max-w-7xl mx-auto px-10 py-12\" data-kid=\"19\">\n    \n    <div class=\"mb-10 flex items-center justify-between\" data-kid=\"20\">\n      <div data-kid=\"21\">\n        <h2 class=\"font-['Sora'] text-4xl font-extrabold text-white mb-2 tracking-tight\" data-kid=\"22\">Call Dispatch <span class=\"text-[#0FFFFF]\" data-kid=\"23\">Center</span></h2>\n        <div class=\"flex items-center gap-2 text-[#64748B] text-sm\" data-kid=\"24\">\n          <span data-kid=\"25\">Operations</span>\n          <i class=\"ti ti-chevron-right text-[10px]\" data-kid=\"26\"></i>\n          <span class=\"text-[#94A3B8]\" data-kid=\"27\">Dispatch Protocol</span>\n        </div>\n      </div>\n      \n      <div class=\"flex bg-[#0d1117] rounded-xl p-1.5 border border-white/5 shadow-inner\" data-kid=\"28\">\n        <button onclick=\"switchTab('single')\" id=\"tab-single-btn\" class=\"px-8 py-2.5 rounded-lg text-sm font-bold transition-all bg-[#0FFFFF] text-[#010B13] shadow-[0_0_20px_rgba(15,255,255,0.3)] cursor-pointer\" data-kid=\"29\">SINGLE DISPATCH</button>\n        <button onclick=\"switchTab('batch')\" id=\"tab-batch-btn\" class=\"px-8 py-2.5 rounded-lg text-sm font-bold text-[#64748B] hover:text-[#94A3B8] transition-all cursor-pointer\" data-kid=\"30\">BATCH DISPATCH</button>\n      </div>\n    </div>\n\n    \n    <div class=\"grid grid-cols-12 gap-10\" data-kid=\"31\">\n      \n      \n      <div class=\"col-span-4 space-y-6\" data-kid=\"32\">\n        <div class=\"glass p-8 rounded-[32px] relative overflow-hidden group min-h-[600px] border-[#0FFFFF]/10\" data-kid=\"33\">\n          <div class=\"scanning-line\" data-kid=\"34\"></div>\n          \n          <div class=\"absolute -top-32 -left-32 w-64 h-64 bg-[#0FFFFF]/10 rounded-full blur-[80px] group-hover:bg-[#0FFFFF]/20 transition-all duration-700\" data-kid=\"35\"></div>\n          <div class=\"absolute -bottom-32 -right-32 w-64 h-64 bg-[#6C3082]/20 rounded-full blur-[80px] group-hover:bg-[#6C3082]/30 transition-all duration-700\" data-kid=\"36\"></div>\n          \n          <div class=\"relative z-10\" data-kid=\"37\">\n            <div class=\"w-16 h-16 rounded-2xl bg-[#0FFFFF]/5 border border-[#0FFFFF]/20 flex items-center justify-center mb-8 shadow-[inset_0_0_15px_rgba(15,255,255,0.1)]\" data-kid=\"38\">\n              <i class=\"ti ti-activity text-[#0FFFFF] text-3xl\" data-kid=\"39\"></i>\n            </div>\n            \n            <h3 class=\"font-['Sora'] text-2xl font-bold text-white mb-4\" data-kid=\"40\">Protocol Intelligence</h3>\n            <p class=\"text-[#94A3B8] leading-relaxed mb-10 text-sm\" data-kid=\"41\">\n              Deploy high-fidelity AI voice agents across global SIP networks. Our dispatch engine handles real-time negotiation and intent recognition.\n            </p>\n            \n            <div class=\"space-y-6\" data-kid=\"42\">\n              <div class=\"flex gap-4\" data-kid=\"43\">\n                <div class=\"w-10 h-10 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center shrink-0\" data-kid=\"44\">\n                  <i class=\"ti ti-phone-calling text-[#0FFFFF]\" data-kid=\"45\"></i>\n                </div>\n                <div data-kid=\"46\">\n                  <h4 class=\"text-sm font-semibold text-white mb-1\" data-kid=\"47\">E.164 Global Compliance</h4>\n                  <p class=\"text-xs text-[#64748B]\" data-kid=\"48\">Automated number normalization and regulatory filtering.</p>\n                </div>\n              </div>\n              \n              <div class=\"flex gap-4\" data-kid=\"49\">\n                <div class=\"w-10 h-10 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center shrink-0\" data-kid=\"50\">\n                  <i class=\"ti ti-microphone text-[#6C3082]\" data-kid=\"51\"></i>\n                </div>\n                <div data-kid=\"52\">\n                  <h4 class=\"text-sm font-semibold text-white mb-1\" data-kid=\"53\">Latency Optimized STT</h4>\n                  <p class=\"text-xs text-[#64748B]\" data-kid=\"54\">Real-time transcription with sub-300ms response cycles.</p>\n                </div>\n              </div>\n              \n              <div class=\"flex gap-4\" data-kid=\"55\">\n                <div class=\"w-10 h-10 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center shrink-0\" data-kid=\"56\">\n                  <i class=\"ti ti-database text-green-500\" data-kid=\"57\"></i>\n                </div>\n                <div data-kid=\"58\">\n                  <h4 class=\"text-sm font-semibold text-white mb-1\" data-kid=\"59\">CRM Auto-Sync</h4>\n                  <p class=\"text-xs text-[#64748B]\" data-kid=\"60\">Direct injection of call outcomes into your lead records.</p>\n                </div>\n              </div>\n            </div>\n\n            <div class=\"mt-16 p-6 rounded-2xl bg-white/2 border border-white/5 relative overflow-hidden group/chart\" data-kid=\"61\">\n              <div class=\"absolute top-0 right-0 w-24 h-24 bg-[#0FFFFF]/5 blur-3xl rounded-full\" data-kid=\"62\"></div>\n              <div class=\"flex items-center justify-between mb-4 relative z-10\" data-kid=\"63\">\n                <span class=\"text-[10px] font-extrabold text-[#94A3B8] group-hover/chart:text-[#0FFFFF] transition-colors uppercase tracking-widest\" data-kid=\"64\">Global Node Latency</span>\n                <span class=\"text-[10px] font-mono text-[#0FFFFF]\" data-kid=\"65\">Active • 2.4ms</span>\n              </div>\n              <div class=\"flex gap-1.5 h-14 items-end relative z-10\" data-kid=\"66\">\n                <div class=\"w-full bg-white/10 h-[45%] rounded-t-[2px] hover:bg-[#0FFFFF]/40 transition-all cursor-crosshair\" data-kid=\"67\"></div>\n                <div class=\"w-full bg-white/10 h-[75%] rounded-t-[2px] hover:bg-[#0FFFFF]/40 transition-all cursor-crosshair\" data-kid=\"68\"></div>\n                <div class=\"w-full bg-[#6C3082]/30 h-[35%] r