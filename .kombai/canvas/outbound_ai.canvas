      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Archivo:wght@300;400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg-main: #010B13;\n    --bg-card: #111827;\n    --accent-cyan: #0FFFFF;\n    --accent-purple: #6C3082;\n    --text-primary: #e2e8f0;\n    --text-muted: #94a3b8;\n    --border-dim: rgba(255, 255, 255, 0.05);\n  }\n\n  body {\n    background-color: var(--bg-main);\n    color: var(--text-primary);\n    font-family: 'Archivo', sans-serif;\n    margin: 0;\n    min-height: 1200px;\n    background-image: \n      radial-gradient(circle at 0% 0%, rgba(15, 255, 255, 0.03) 0%, transparent 50%),\n      radial-gradient(circle at 100% 100%, rgba(108, 48, 130, 0.03) 0%, transparent 50%);\n  }\n\n  .font-sora { font-family: 'Sora', sans-serif; }\n\n  /* Grid Overlay */\n  .grid-overlay {\n    position: fixed;\n    inset: 0;\n    background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),\n                      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);\n    background-size: 40px 40px;\n    pointer-events: none;\n    z-index: 0;\n  }\n\n  /* Glassmorphism */\n  .glass {\n    background: rgba(17, 24, 39, 0.6);\n    backdrop-filter: blur(12px);\n    border: 1px solid var(--border-dim);\n  }\n\n  /* Neon Glow Utilities */\n  .neon-glow-hover:hover {\n    border-color: var(--accent-cyan);\n    box-shadow: 0 0 15px rgba(15, 255, 255, 0.2), 0 0 30px rgba(15, 255, 255, 0.05);\n  }\n\n  .neon-glow-purple-hover:hover {\n    border-color: var(--accent-purple);\n    box-shadow: 0 0 15px rgba(108, 48, 130, 0.2), 0 0 30px rgba(108, 48, 130, 0.05);\n  }\n\n  /* Navigation */\n  .nav-link {\n    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n    position: relative;\n    border-left: 3px solid transparent;\n  }\n  .nav-link.active {\n    background: linear-gradient(90deg, rgba(15, 255, 255, 0.1) 0%, transparent 100%);\n    border-left-color: var(--accent-cyan);\n    color: var(--accent-cyan);\n    text-shadow: 0 0 10px rgba(15, 255, 255, 0.3);\n  }\n\n  /* Tabs Panel */\n  .tab-panel { display: none; }\n  .tab-panel.active { display: block; animation: fadeInUp 0.4s ease-out; }\n\n  @keyframes fadeInUp {\n    from { opacity: 0; transform: translateY(10px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n\n  /* KPI Cards */\n  .kpi-card {\n    background: #111827;\n    border: 1px solid var(--border-dim);\n    box-shadow: 8px 8px 20px rgba(0,0,0,0.4), -4px -4px 15px rgba(255,255,255,0.01); /* Enhanced #neomorph-raised */\n  }\n\n  /* Custom Scrollbar */\n  ::-webkit-scrollbar { width: 6px; }\n  ::-webkit-scrollbar-track { background: var(--bg-main); }\n  ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 3px; }\n  ::-webkit-scrollbar-thumb:hover { background: #334155; }\n\n  /* Badge Styles */\n  .status-badge {\n    padding: 2px 8px;\n    border-radius: 999px;\n    font-size: 10px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n  }\n</style>\n\n<div class=\"grid-overlay\" data-kid=\"1\"></div>\n\n<div class=\"relative z-10 flex min-h-[900px]\" data-kid=\"2\">\n  \n  <aside class=\"w-[280px] shrink-0 border-r border-white/5 flex flex-col glass\" data-kid=\"3\">\n    <div class=\"p-8\" data-kid=\"4\">\n      <div class=\"flex items-center gap-3 mb-10 group cursor-pointer\" data-kid=\"5\">\n        <div class=\"w-10 h-10 rounded-xl bg-gradient-to-br from-[#0FFFFF] to-[#6C3082] flex items-center justify-center shadow-lg shadow-cyan-500/20 group-hover:scale-105 transition-transform\" data-kid=\"6\">\n          <i class=\"ti ti-robot text-white text-xl\" data-kid=\"7\"></i>\n        </div>\n        <div class=\"font-sora font-extrabold text-xl tracking-tighter\" data-kid=\"8\">\n          Outbound<span class=\"text-transparent bg-clip-text bg-gradient-to-r from-[#0FFFFF] to-[#6C3082]\" data-kid=\"9\">AI</span>\n        </div>\n      </div>\n\n      <nav class=\"space-y-1\" data-kid=\"10\">\n        <button onclick=\"switchTab('stats')\" id=\"nav-stats\" class=\"nav-link active w-full flex items-center gap-3 px-4 py-3 text-sm font-medium hover:bg-white/5\" data-kid=\"11\">\n          <i class=\"ti ti-activity text-lg\" data-kid=\"12\"></i> Dashboard\n        </button>\n        <button onclick=\"switchTab('call')\" id=\"nav-call\" class=\"nav-link w-full flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-400 hover:text-white hover:bg-white/5\" data-kid=\"13\">\n          <i class=\"ti ti-phone-call text-lg\" data-kid=\"14\"></i> Single Call\n        </button>\n        <button onclick=\"switchTab('batch')\" id=\"nav-batch\" class=\"nav-link w-full flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-400 hover:text-white hover:bg-white/5\" data-kid=\"15\">\n          <i class=\"ti ti-layers-intersect text-lg\" data-kid=\"16\"></i> Batch Call\n        </button>\n        <button onclick=\"switchTab('campaigns')\" id=\"nav-campaigns\" class=\"nav-link w-full flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-400 hover:text-white hover:bg-white/5\" data-kid=\"17\">\n          <i class=\"ti ti-rocket text-lg\" data-kid=\"18\"></i> Campaigns\n        </button>\n        <button onclick=\"switchTab('agents')\" id=\"nav-agents\" class=\"nav-link w-full flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-400 hover:text-white hover:bg-white/5\" data-kid=\"19\">\n          <i class=\"ti ti-user-robot text-lg\" data-kid=\"20\"></i> Agent Profiles\n        </button>\n        <button onclick=\"switchTab('prompt')\" id=\"nav-prompt\" class=\"nav-link w-full flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-400 hover:text-white hover:bg-white/5\" data-kid=\"21\">\n          <i class=\"ti ti-edit text-lg\" data-kid=\"22\"></i> AI Prompt\n        </button>\n        <div class=\"py-4 px-4\" data-kid=\"23\">\n          <div class=\"h-px bg-white/5 w-full\" data-kid=\"24\"></div>\n        </div>\n        <button onclick=\"switchTab('calls')\" id=\"nav-calls\" class=\"nav-link w-full flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-400 hover:text-white hover:bg-white/5\" data-kid=\"25\">\n          <i class=\"ti ti-list text-lg\" data-kid=\"26\"></i> Call Logs\n        </button>\n        <button onclick=\"switchTab('crm')\" id=\"nav-crm\" class=\"nav-link w-full flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-400 hover:text-white hover:bg-white/5\" data-kid=\"27\">\n          <i class=\"ti ti-users text-lg\" data-kid=\"28\"></i> CRM\n        </button>\n        <button onclick=\"switchTab('settings')\" id=\"nav-settings\" class=\"nav-link w-full flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-400 hover:text-white hover:bg-white/5\" data-kid=\"29\">\n          <i class=\"ti ti-settings text-lg\" data-kid=\"30\"></i> Settings\n        </button>\n      </nav>\n    </div>\n\n    <div class=\"mt-auto p-8\" data-kid=\"31\">\n      <div class=\"bg-[#0f172a]/50 border border-white/10 rounded-2xl p-4 relative overflow-hidden group\" data-kid=\"32\">\n        <div class=\"absolute top-0 right-0 w-24 h-24 bg-emerald-500/10 blur-3xl pointer-events-none group-hover:bg-emerald-500/20 transition-all\" data-kid=\"33\"></div>\n        <div class=\"flex items-center gap-2 mb-3\" data-kid=\"34\">\n          <span class=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\" data-kid=\"35\"></span>\n          <span class=\"text-[10px] font-black text-emerald-500 tracking-widest uppercase\" data-kid=\"36\">System Core Live</span>\n        </div>\n        <div class=\"text-[10px] text-slate-400 leading-relaxed font-medium\" data-kid=\"37\">\n          v2.5.2-stable — Node cluster active.<br data-kid=\"38\">\n          Latency: <span class=\"text-cyan-400 font-bold\" data-kid=\"39\">84ms</span> avg.\n        </div>\n      </div>\n    </div>\n  </aside>\n\n  \n  <main class=\"flex-1 flex flex-col\" data-kid=\"40\">\n    \n    <header class=\"h-16 border-b border-white/5 flex items-center px-8 justify-between glass relative z-50\" data-kid=\"41\">\n      <div class=\"relative w-96 group\" data-kid=\"42\">\n        <i class=\"ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 group-focus-within:text-cyan-400 transition-colors\" data-kid=\"43\"></i>\n        <input type=\"text\" placeholder=\"Search interactions, contacts...\" class=\"w-full bg-white/5 border border-white/10 rounded-xl pl-10 pr-4 py-2 text-sm outline-none focus:border-cyan-400/50 focus:ring-1 focus:ring-cyan-400/50 transition-all\" data-kid=\"44\">\n      </div>\n      <div class=\"flex items-center gap-4\" data-kid=\"45\">\n        <div class=\"flex gap-2\" data-kid=\"46\">\n          <button class=\"w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center text-slate-400 hover:text-white hover:bg-white/10 transition-all border border-white/10\" data-kid=\"47\">\n            <i class=\"ti ti-bell\" data-kid=\"48\"></i>\n          </button>\n          <button class=\"w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center text-slate-400 hover:text-white hover:bg-white/10 transition-all border border-white/10\" data-kid=\"49\">\n            <i class=\"ti ti-help\" data-kid=\"50\"></i>\n          </button>\n        </div>\n        <div class=\"h-8 w-px bg-white/10 mx-2\" data-kid=\"51\"></div>\n        <div class=\"flex items-center gap-3 group cursor-pointer\" data-kid=\"52\">\n          <div class=\"text-right\" data-kid=\"53\">\n            <div class=\"text-sm font-bold group-hover:text-cyan-400 transition-colors\" data-kid=\"54\">Alex Chen</div>\n            <div class=\"text-[10px] text-slate-500 font-medium\" data-kid=\"55\">Head of Growth</div>\n          </div>\n          <div class=\"relative\" data-kid=\"56\">\n            <img src=\"https://i.pravatar.cc/100?u=alex\" class=\"w-10 h-10 rounded-xl border-2 border-white/10 p-0.5 group-hover:border-cyan-400 transition-all\" data-kid=\"57\">\n            <span class=\"absolute -bottom-1 -right-1 w-3 h-3 bg-emerald-500 border-2 border-[#010B13] rounded-full\" data-kid=\"58\"></span>\n          </div>\n        </div>\n      </div>\n    </header>\n\n    <div class=\"p-8 space-y-8 flex-1\" data-kid=\"59\">\n      \n      <div class=\"tab-panel active\" id=\"tab-stats\" data-kid=\"60\">\n        <div class=\"flex items-end justify-between mb-8\" data-kid=\"61\">\n          <div data-kid=\"62\">\n            <h1 class=\"font-sora text-3xl font-extrabold text-white mb-2\" data-kid=\"63\">Performance Dashboard</h1>\n            <p class=\"text-slate-400 text-sm\" data-kid=\"64\">Real-time intelligence from your AI voice agents.</p>\n          </div>\n          <div class=\"flex gap-3\" data-kid=\"65\">\n            <button class=\"px-4 py-2 bg-white/5 border border-white/10 rounded-xl text-xs font-bold hover:bg-white/10 transition-all flex items-center gap-2\" data-kid=\"66\">\n              <i class=\"ti ti-calendar\" data-kid=\"67\"></i> Last 14 Days\n            </button>\n            <button class=\"px-4 py-2 bg-cyan-400 text-black rounded-xl text-xs font-bold hover:bg-cyan-300 transition-all shadow-lg shadow-cyan-500/20 flex items-center gap-2\" data-kid=\"68\">\n              <i class=\"ti ti-download\" data-kid=\"69\"></i> Export Reports\n            </button>\n          </div>\n        </div>\n\n        \n        <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-8\" id=\"kpi-grid\" data-kid=\"70\">\n          <div class=\"kpi-card rounded-2xl p-6 relative overflow-hidden group neon-glow-hover transition-all\" data-kid=\"71\">\n            <div class=\"absolute top-0 left-0 w-1 h-full bg-cyan-400\" data-kid=\"72\"></div>\n            <div class=\"text-[10px] font-black tracking-widest text-cyan-400 uppercase mb-4\" data-kid=\"73\">Total Calls</div>\n            <div class=\"font-sora text-4xl font-extrabold text-white mb-2\" id=\"kpi-total\" data-kid=\"74\">2,842</div>\n            <div class=\"text-[11px] text-slate-500 flex items-center gap-1 font-medium\" data-kid=\"75\">\n              <span class=\"text-emerald-400\" data-kid=\"76\">↑ 12.4%</span> vs previous week\n            </div>\n          </div>\n          <div class=\"kpi-card rounded-2xl p-6 relative overflow-hidden group neon-glow-purple-hover transition-all\" data-kid=\"77\">\n            <div class=\"absolute top-0 left-0 w-1 h-full bg-[#6C3082]\" data-kid=\"78\"></div>\n            <div class=\"text-[10px] font-black tracking-widest text-purple-400 uppercase mb-4\" data-kid=\"79\">Booked</div>\n            <div class=\"font-sora text-4xl font-extrabold text-white mb-2\" id=\"kpi-booked\" data-kid=\"80\">412</div>\n            <div class=\"text-[11px] text-slate-500 font-medium\" data-kid=\"81\">Appointments confirmed</div>\n          </div>\n          <div class=\"kpi-card rounded-2xl p-6 relative overflow-hidden group hover:border-rose-500/30 transition-all\" data-kid=\"82\">\n            <div class=\"absolute top-0 left-0 w-1 h-full bg-rose-500\" data-kid=\"83\"></div>\n            <div class=\"text-[10px] font-black tracking-widest text-slate-500 uppercase mb-4 group-hover:text-rose-400\" data-kid=\"84\">Not Interested</div>\n            <div class=\"font-sora text-4xl font-extrabold text-white mb-2\" id=\"kpi-ni\" data-kid=\"85\">184</div>\n            <div class=\"text-[11px] text-slate-500 font-medium\" data-kid=\"86\">Declined interactions</div>\n          </div>\n          <div class=\"kpi-card rounded-2xl p-6 relative overflow-hidden group neon-glow-hover transition-all\" data-kid=\"87\">\n            <div class=\"absolute top-0 left-0 w-1 h-full bg-cyan-400\" data-kid=\"88\"></div>\n            <div class=\"text-[10px] font-black tracking-widest text-cyan-400 uppercase mb-4\" data-kid=\"89\">Booking Rate</div>\n            <div class=\"font-sora text-4xl font-extrabold text-cyan-400 mb-2\" id=\"kpi-rate\" data-kid=\"90\">14.5%</div>\n            <div class=\"text-[11px] text-slate-500 font-medium\" data-kid=\"91\">Conversion efficiency</div>\n          </div>\n          <div class=\"kpi-card rounded-2xl p-6 relative overflow-hidden group transition-all\" data-kid=\"92\">\n            <div class=\"absolute top-0 left-0 w-1 h-full bg-slate-700 opacity-50\" data-kid=\"93\"></div>\n            <div class=\"text-[10px] font-black tracking-widest text-slate-500 uppercase mb-4\" data-kid=\"94\">Avg Duration</div>\n            <div class=\"font-sora text-4xl font-extrabold text-white mb-2\" id=\"kpi-dur\" data-kid=\"95\">156s</div>\n            <div class=\"text-[11px] text-slate-500 font-medium\" data-kid=\"96\">Session average</div>\n          </div>\n        </div>\n\n        \n        <div class=\"flex flex-wrap gap-3 mb-8\" id=\"live-config-chips\" data-kid=\"97\">\n          \n        </div>\n\n        \n        <div class=\"mb-8\" data-kid=\"98\">\n          <div class=\"flex items-center justify-between mb-4 px-1\" data-kid=\"99\">\n             <h3 class=\"font-sora font-bold text-xs uppercase tracking-[0.2em] text-slate-500\" data-kid=\"100\">Live Channels</h3>\n             <span class=\"text-[10px] text-cyan-400 font-bold bg-cyan-400/10 px-2 py-0.5 rounded-full\" data-kid=\"101\">3 ACTIVE</span>\n          </div>\n          <div class=\"flex gap-4 overflow-x-auto pb-4 scrollbar-hide\" data-kid=\"102\">\n             <div class=\"glass min-w-[300px] p-5 rounded-2xl border-l-4 border-cyan-400 hover:bg-white/5 transition-all\" data-kid=\"103\">\n                <div class=\"flex justify-between items-start mb-3\" data-kid=\"104\">\n                   <div class=\"text-sm font-bold\" data-kid=\"105\">Dental Outreach Q2</div>\n                   <span class=\"text-[10px] font-mono text-cyan-400\" data-kid=\"106\">84%</span>\n                </div>\n                <div class=\"w-full h-1 bg-white/10 rounded-full mb-3\" data-kid=\"107\">\n                   <div class=\"w-[84%] h-full bg-cyan-400 rounded-full shadow-[0_0_8px_rgba(15,255,255,0.5)]\" data-kid=\"108\"></div>\n                </div>\n                <div class=\"text-[10px] text-slate-500 flex justify-between\" data-kid=\"109\">\n                   <span data-kid=\"110\">421 Calls</span>\n                   <span data-kid=\"111\">65 Booked</span>\n                </div>\n             </div>\n             <div class=\"glass min-w-[300px] p-5 rounded-2xl border-l-4 border-purple-500 hover:bg-white/5 transition-all\" data-kid=\"112\">\n                <div class=\"flex justify-between items-start mb-3\" data-kid=\"113\">\n                   <div class=\"text-sm font-bold\" data-kid=\"114\">Insurance Followup</div>\n                   <span class=\"text-[10px] font-mono text-purple-400\" data-kid=\"115\">32%</span>\n                </div>\n                <div class=\"w-full h-1 bg-white/10 rounded-full mb-3\" data-kid=\"116\">\n                   <div class=\"w-[32%] h-full bg-purple-400 rounded-full shadow-[0_0_8px_rgba(108,48,130,0.5)]\" data-kid=\"117\"></div>\n                </div>\n                <div class=\"text-[10px] text-slate-500 flex justify-between\" data-kid=\"118\">\n                   <span data-kid=\"119\">128 Calls</span>\n                   <span data-kid=\"120\">12 Booked</span>\n                </div>\n             </div>\n             <div class=\"glass min-w-[300px] p-5 rounded-2xl border-l-4 border-slate-700 opacity-60 hover:opacity-100 transition-all\" data-kid=\"121\">\n                <div class=\"flex justify-between items-start mb-3\" data-kid=\"122\">\n                   <div class=\"text-sm font-bold\" data-kid=\"123\">Inbound Reactivation</div>\n                   <span class=\"text-[10px] font-mono text-slate-400\" data-kid=\"124\">Paused</span>\n                </div>\n                <div class=\"w-full h-1 bg-white/10 rounded-full mb-3\" data-kid=\"125\">\n                   <div class=\"w-full h-full bg-slate-700 rounded-full\" data-kid=\"126\"></div>\n                </div>\n                <div class=\"text-[10px] text-slate-500 flex justify-between\" data-kid=\"127\">\n                   <span data-kid=\"128\">0 Calls</span>\n                   <span data-kid=\"129\">Scheduled: 09:00</span>\n                </div>\n             </div>\n          </div>\n        </div>\n\n        \n        <div class=\"grid grid-cols-12 gap-6\" data-kid=\"130\">\n          <div class=\"col-span-12 lg:col-span-8 glass rounded-3xl overflow-hidden flex flex-col\" data-kid=\"131\">\n            <div class=\"p-6 border-b border-white/5 flex items-center justify-between bg-white/[0.02]\" data-kid=\"132\">\n              <div data-kid=\"133\">\n                <h3 class=\"font-sora font-bold text-white\" data-kid=\"134\">Inbound Activity Dynamics</h3>\n                <p class=\"text-[10px] text-slate-500 uppercase tracking-widest font-bold\" data-kid=\"135\">14-Day Performance Trajectory</p>\n              </div>\n              <div class=\"flex items-center gap-2\" data-kid=\"136\">\n                <span class=\"flex items-center gap-1.5 text-[10px] font-bold text-slate-400\" data-kid=\"137\">\n                  <span class=\"w-2 h-2 rounded-full bg-cyan-400\" data-kid=\"138\"></span> Call Volume\n                </span>\n              </div>\n            </div>\n            <div class=\"p-6 h-[320px]\" data-kid=\"139\">\n              <canvas id=\"chart-timeline\" data-kid=\"140\"></canvas>\n            </div>\n          </div>\n\n          <div class=\"col-span-12 lg:col-span-4 glass rounded-3xl overflow-hidden flex flex-col\" data-kid=\"141\">\n            <div class=\"p-6 border-b border-white/5\" data-kid=\"142\">\n              <h3 class=\"font-sora font-bold\" data-kid=\"143\">Outcome Analysis</h3>\n              <p class=\"text-[10px] text-slate-500 uppercase tracking-widest font-bold\" data-kid=\"144\">Relative Distribution</p>\n            </div>\n            <div class=\"p-6 flex-1 flex flex-col\" data-kid=\"145\">\n              <div class=\"h-[200px] mb-6 relative\" data-kid=\"146\">\n                 <canvas id=\"chart-donut\" data-kid=\"147\"></canvas>\n                 <div class=\"absolute inset-0 flex items-center justify-center pointer-events-none\" data-kid=\"148\">\n                    <div class=\"text-center\" data-kid=\"149\">\n                      <div class=\"text-xl font-sora font-black\" id=\"donut-total\" data-kid=\"150\">0</div>\n                      <div class=\"text-[8px] text-slate-500 font-bold uppercase tracking-tighter\" data-kid=\"151\">Total Logged</div>\n                    </div>\n                 </div>\n              </div>\n              <div id=\"chart-legend\" class=\"space-y-3\" data-kid=\"152\"></div>\n            </div>\n          </div>\n          \n          <div class=\"col-span-12 glass rounded-3xl overflow-hidden\" data-kid=\"153\">\n             <div class=\"p-6 border-b border-white/5\" data-kid=\"154\">\n                <h3 class=\"font-sora font-bold\" data-kid=\"155\">Efficiency by Outcome</h3>\n                <p class=\"text-[10px] text-slate-500 uppercase tracking-widest font-bold\" data-kid=\"156\">Average Duration per category</p>\n             </div>\n             <div class=\"p-6 h-[240px]\" data-kid=\"157\">\n                <canvas id=\"chart-duration\" data-kid=\"158\"></canvas>\n             </div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"tab-panel\" id=\"tab-call\" data-kid=\"159\">\n         <div class=\"max-w-4xl\" data-kid=\"160\">\n           <h1 class=\"font-sora text-3xl font-extrabold text-white mb-2\" data-kid=\"161\">Dispatch Single Call</h1>\n           <p class=\"text-slate-400 text-sm mb-8\" data-kid=\"162\">Initiate an immediate AI-driven interaction.</p>\n           \n           <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\" data-kid=\"163\">\n             <div class=\"glass p-8 rounded-3xl space-y-6\" data-kid=\"164\">\n                <form id=\"call-form\" onsubmit=\"dispatchCall(event)\" class=\"space-y-4\" data-kid=\"165\">\n                  <div data-kid=\"166\">\n                    <label class=\"block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-2\" data-kid=\"167\">Target Phone Number</label>\n                    <input type=\"tel\" id=\"f-phone\" placeholder=\"+1234567890\" class=\"w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-cyan-400/50 outline-none transition-all\" data-kid=\"168\">\n                  </div>\n                  <div class=\"grid grid-cols-2 gap-4\" data-kid=\"169\">\n                    <div data-kid=\"170\">\n                      <label class=\"block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-2\" data-kid=\"171\">Lead Name</label>\n                      <input type=\"text\" id=\"f-lead\" placeholder=\"Jane Doe\" class=\"w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-cyan-400/50 outline-none transition-all\" data-kid=\"172\">\n                    </div>\n                    <div data-kid=\"173\">\n                      <label class=\"block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-2\" data-kid=\"174\">Business</label>\n                      <input type=\"text\" id=\"f-biz\" placeholder=\"Acme Inc\" class=\"w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-cyan-400/50 outline-none transition-all\" data-kid=\"175\">\n                    </div>\n                  </div>\n                  <div data-kid=\"176\">\n                    <label class=\"block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-2\" data-kid=\"177\">Agent Profile</label>\n                    <select id=\"f-agent-profile\" class=\"w-full bg-[#111827] border border-white/10 rounded-xl px-4 py-3 text-sm focus:border-cyan-400/50 outline-none transition-all appearance-none\" data-kid=\"178\">\n                      <option value data-kid=\"179\">Default Profile</option>\n                    </select>\n                  </div>\n                  <button type=\"submit\" id=\"call-submit-btn\" class=\"w-full py-4 bg-cyan-400 text-black font-sora font-extrabold rounded-xl hover:bg-cyan-300 transition-all flex items-center justify-center gap-3\" data-kid=\"180\">\n                    <i class=\"ti ti-phone-calling\" data-kid=\"181\"></i> INITIATE QUANTUM CALL\n                  </button>\n                  <div id=\"call-err\" class=\"text-rose-500 text-xs text-center mt-2 hidden\" data-kid=\"182\"></div>\n                </form>\n             </div>\n             \n             <div class=\"space-y-6\" data-kid=\"183\">\n                <div class=\"glass p-6 rounded-3xl border-l-4 border-cyan-400\" data-kid=\"184\">\n                  <h4 class=\"font-sora font-bold mb-2\" data-kid=\"185\">AI Dispatch Engine</h4>\n                  <p class=\"text-xs text-slate-400 leading-relaxed\" data-kid=\"186\">Our proprietary Realtime-Flash engine ensures sub-500ms latency between voice frames. Enter E.164 format for global compliance.</p>\n                </div>\n                <img src=\"https://images.unsplash.com/photo-1606814540563-5c02d62fd409?auto=format&w=600&q=80&fit=crop\" class=\"w-full h-48 object-cover rounded-3xl opacity-60 grayscale hover:grayscale-0 transition-all duration-700\" alt=\"Fiber Optic\" decoding=\"async\" loading=\"lazy\" data-kid=\"187\">\n             </div>\n           </div>\n         </div>\n      </div>\n      \n      \n      <div class=\"tab-panel\" id=\"tab-batch\" data-kid=\"188\">\n        <h1 class=\"font-sora text-3xl font-extrabold text-white mb-2\" data-kid=\"189\">Batch Call Dispatch</h1>\n        <p class=\"text-slate-400 text-sm mb-8\" data-kid=\"190\">Process large datasets with parallel AI agents.</p>\n        <div class=\"glass p-8 rounded-3xl border-dashed border-2 border-white/10 flex flex-col items-center justify-center text-center\" data-kid=\"191\">\n          <div class=\"w-16 h-16 rounded-2xl bg-white/5 flex items-center justify-center mb-4\" data-kid=\"192\">\n            <i class=\"ti ti-upload text-3xl text-slate-500\" data-kid=\"193\"></i>\n          </div>\n          <h3 class=\"font-sora font-bold mb-1\" data-kid=\"194\">Upload Contacts Manifest</h3>\n          <p class=\"text-xs text-slate-500 mb-6\" data-kid=\"195\">Drop your .csv file here or click to browse</p>\n          <input type=\"file\" id=\"bc-file\" onchange=\"parseCSV()\" class=\"hidden\" data-kid=\"196\">\n          <label for=\"bc-file\" class=\"px-8 py-3 bg-white/5 border border-white/10 rounded-xl text-xs font-bold cursor-pointer hover:bg-white/10 transition-all\" data-kid=\"197\">SELECT FILE</label>\n        </div>\n        <div id=\"bc-preview\" class=\"mt-8 hidden\" data-kid=\"198\">\n           <div class=\"flex items-center justify-between mb-4\" data-kid=\"199\">\n              <div class=\"font-bold text-sm\" data-kid=\"200\">Preview: <span id=\"bc-count\" class=\"text-cyan-400\" data-kid=\"201\">0</span> contacts</div>\n              <button onclick=\"startBatch()\" id=\"bc-start-btn\" class=\"px-6 py-2 bg-emerald-500 text-white font-bold rounded-lg text-xs hover:bg-emerald-400\" data-kid=\"202\">START BATCH</button>\n           </div>\n           <div class=\"glass rounded-2xl overflow-hidden\" data-kid=\"203\">\n              <table class=\"w-full text-left text-xs\" data-kid=\"204\">\n                <thead class=\"bg-white/5\" data-kid=\"205\">\n                  <tr data-kid=\"206\">\n                    <th class=\"px-4 py-3\" data-kid=\"207\">Phone</th>\n                    <th class=\"px-4 py-3\" data-kid=\"208\">Lead</th>\n                    <th class=\"px-4 py-3\" data-kid=\"209\">Business</th>\n                    <th class=\"px-4 py-3\" data-kid=\"210\">Service</th>\n                  </tr>\n                </thead>\n                <tbody id=\"bc-table\" class=\"divide-y divide-white/5\" data-kid=\"211\"></tbody>\n              </table>\n           </div>\n        </div>\n      </div>\n      \n      \n      <div class=\"tab-panel\" id=\"tab-logs\" data-kid=\"212\">\n        <div class=\"flex items-center justify-between mb-8\" data-kid=\"213\">\n          <div data-kid=\"214\">\n            <h1 class=\"font-sora text-3xl font-extrabold text-white mb-2\" data-kid=\"215\">System Stream</h1>\n            <p class=\"text-slate-400 text-sm\" data-kid=\"216\">Real-time server and agent telemetry logs.</p>\n          </div>\n          <div class=\"flex gap-2\" data-kid=\"217\">\n            <button onclick=\"clearLogs()\" class=\"px-4 py-2 bg-rose-500/20 text-rose-500 border border-rose-500/30 rounded-xl text-xs font-bold hover:bg-rose-500/30 transition-all\" data-kid=\"218\">CLEAR ALL</button>\n            <button id=\"log-pause-btn\" onclick=\"toggleLogsPause()\" class=\"px-4 py-2 bg-white/5 border border-white/10 rounded-xl text-xs font-bold hover:bg-white/10 transition-all\" data-kid=\"219\">PAUSE STREAM</button>\n          </div>\n        </div>\n        <div class=\"glass rounded-3xl p-6 font-mono text-[11px] h-[600px] overflow-y-auto space-y-1 bg-black/40\" id=\"logs-container\" data-kid=\"220\">\n           <div class=\"text-slate-500\" data-kid=\"221\">Connecting to telemetry cluster...</div>\n        </div>\n      </div>\n\n      \n      <div class=\"tab-panel\" id=\"tab-crm\" data-kid=\"222\">\n        <h1 class=\"font-sora text-3xl font-extrabold text-white mb-8\" data-kid=\"223\">CRM — Contact Intelligence</h1>\n        <div class=\"glass rounded-3xl overflow-hidden\" data-kid=\"224\">\n          <table class=\"w-full text-left text-xs\" data-kid=\"225\">\n            <thead class=\"bg-white/5\" data-kid=\"226\">\n              <tr data-kid=\"227\">\n                <th class=\"px-6 py-4 font-black uppercase tracking-widest text-slate-500\" data-kid=\"228\">Contact</th>\n                <th class=\"px-6 py-4 font-black uppercase tracking-widest text-slate-500\" data-kid=\"229\">Lead Name</th>\n                <th class=\"px-6 py-4 font-black uppercase tracking-widest text-slate-500\" data-kid=\"230\">Interaction History</th>\n                <th class=\"px-6 py-4 font-black uppercase tracking-widest text-slate-500\" data-kid=\"231\">Last Outcome</th>\n                <th class=\"px-6 py-4 font-black uppercase tracking-widest text-slate-500\" data-kid=\"232\">Action</th>\n              </tr>\n            </thead>\n            <tbody id=\"crm-table\" class=\"divide-y divide-white/5\" data-kid=\"233\"></tbody>\n          </table>\n        </div>\n      </div>\n\n    </div>\n  </main>\n</div>\n\n\n<div id=\"toast-container\" class=\"fixed bottom-8 right-8 z-[9999] flex flex-col gap-3\" data-kid=\"234\"></div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js\" data-kid=\"235\"></script>\n<script data-kid=\"236\">\n// Logic replication from original source\nconst $ = id => document.getElementById(id);\nconst api = (path, opts) => fetch(path, opts).then(r => r.json()).catch(e => ({error: e.message}));\nconst apiPost = (path, body) => fetch(path, {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body)});\nconst apiPatch = (path, body) => fetch(path, {method:'PATCH',headers:{'Content-Type':'application/json'}, body:JSON.stringify(body)});\nconst apiDel = path => fetch(path, {method:'DELETE'});\n\nfunction toast(msg, type='ok') {\n  const el = document.createElement('div');\n  const colors = type === 'ok' ? 'border-cyan-400 bg-cyan-400/10 text-cyan-400' : 'border-rose-500 bg-rose-500/10 text-rose-500';\n  el.className = `px-6 py-3 rounded-2xl border glass flex items-center gap-3 animate-slideIn ${colors} shadow-2xl`;\n  el.innerHTML = `<i class=\"ti ti-${type==='ok'?'check':'alert-circle'}\"></i> <span>${msg}</span>`;\n  $('toast-container').appendChild(el);\n  setTimeout(() => {\n    el.style.opacity = '0';\n    el.style.transform = 'translateX(50px)';\n    setTimeout(() => el.remove(), 400);\n  }, 4000);\n}\n\n// Chart Instance Store\nlet _charts = {};\n\nfunction switchTab(name) {\n  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));\n  document.querySelectorAll('.nav-link').forEach(b => b.classList.remove('active'));\n  $(`tab-${name}`).classList.add('active');\n  $(`nav-${name}`).classList.add('active');\n  \n  if (name === 'stats') { loadStats(); loadLiveConfig(); }\n  if (name === 'crm') loadCRM();\n  if (name === 'logs') loadLogs();\n}\n\nasync function loadStats() {\n  const d = await api('/api/stats');\n  if (d.error) return;\n  $('kpi-total').textContent = d.total_calls ?? 0;\n  $('kpi-booked').textContent = d.booked ?? 0;\n  $('kpi-ni').textContent = d.not_interested ?? 0;\n  $('kpi-rate').textContent = (d.booking_rate_percent ?? 0) + '%';\n  $('kpi-dur').textContent = (d.avg_duration_seconds ?? 0) + 's';\n  if (d.total_calls) $('donut-total').textContent = d.total_calls;\n  _renderCharts(d);\n}\n\nasync function loadLiveConfig() {\n  const [s, p] = await Promise.all([api('/api/settings'), api('/api/prompt')]);\n  const chips = $('live-config-chips');\n  if (!chips) return;\n  const items = [\n    ['Model', s['GEMINI_MODEL']?.value || '—', 'ti-brain'],\n    ['Voice', s['GEMINI_TTS_VOICE']?.value || '—', 'ti-microphone'],\n    ['LiveKit', s['LIVEKIT_URL']?.configured ? 'Connected' : 'Pending', 'ti-cloud'],\n    ['Vobiz', s['VOBIZ_SIP_DOMAIN']?.configured ? 'Active' : 'Missing', 'ti-antenna'],\n    ['Prompt', p.is_custom ? 'Custom' : 'System', 'ti-prompt']\n  ];\n  chips.innerHTML = items.map(([label, val, icon]) => {\n    const isOk = !['Pending', 'Missing', '—'].includes(val);\n    const borderColor = isOk ? 'border-cyan-400/20' : 'border-rose-400/30';\n    const textColor = isOk ? 'text-cyan-400' : 'text-rose-400';\n    const iconBg = isOk ? 'bg-cyan-400/10' : 'bg-rose-400/10';\n    return `\n      <div class=\"glass px-5 py-3 rounded-2xl flex items-center gap-4 border ${borderColor} transition-all hover:bg-white/5 cursor-default\">\n        <div class=\"w-8 h-8 rounded-lg ${iconBg} flex items-center justify-center\">\n          <i class=\"ti ${icon} ${textColor} text-sm\"></i>\n        </div>\n        <div class=\"flex flex-col\">\n          <span class=\"text-[9px] font-black uppercase text-slate-500 tracking-widest\">${label}</span>\n          <span class=\"text-sm font-bold ${textColor}\">${val}</span>\n        </div>\n      </div>\n    `;\n  }).join('');\n}\n\nfunction _renderCharts(d) {\n  const COLORS = ['#0FFFFF','#6C3082','#10b981','#f59e0b','#ef4444','#3b82f6'];\n  \n  // Timeline Line Chart\n  const tl = d.timeline || [];\n  const existingTimeline = _charts['chart-timeline'];\n  if (existingTimeline) existingTimeline.destroy();\n  \n  const ctxTimeline = $('chart-timeline').getContext('2d');\n  _charts['chart-timeline'] = new Chart(ctxTimeline, {\n    type: 'line',\n    data: {\n      labels: tl.map(t => t.date.slice(5)),\n      datasets: [{\n        label: 'Calls',\n        data: tl.map(t => t.count),\n        borderColor: '#0FFFFF',\n        borderWidth: 3,\n        backgroundColor: (context) => {\n          const chart = context.chart;\n          const {ctx, chartArea} = chart;\n          if (!chartArea) return null;\n          const gradient = ctx.createLinearGradient(0, chartArea.top, 0, chartArea.bottom);\n          gradient.addColorStop(0, 'rgba(15, 255, 255, 0.2)');\n          gradient.addColorStop(1, 'rgba(15, 255, 255, 0)');\n          return gradient;\n        },\n        fill: true,\n        tension: 0.4,\n        pointRadius: 0,\n        pointHoverRadius: 6,\n        pointHoverBackgroundColor: '#0FFFFF'\n      }]\n    },\n    options: {\n      responsive: true,\n      maintainAspectRatio: false,\n      plugins: { legend: { display: false } },\n      scales: {\n        x: { grid: { display: false }, ticks: { color: '#64748b', font: { size: 10, weight: 'bold' } } },\n        y: { grid: { color: 'rgba(255,255,255,0.03)' }, ticks: { color: '#64748b', font: { size: 10, weight: 'bold' } } }\n      }\n    }\n  });\n\n  // Donut Chart\n  const outcomes = d.outcomes || {};\n  const oKeys = Object.keys(outcomes);\n  const existingDonut = _charts['chart-donut'];\n  if (existingDonut) existingDonut.destroy();\n  \n  const ctxDonut = $('chart-donut').getContext('2d');\n  _charts['chart-donut'] = new Chart(ctxDonut, {\n    type: 'doughnut',\n    data: {\n      labels: oKeys,\n      datasets: [{\n        data: oKeys.map(k => outcomes[k]),\n        backgroundColor: COLORS,\n        borderWidth: 0,\n        hoverOffset: 10\n      }]\n    },\n    options: {\n      responsive: true,\n      maintainAspectRatio: false,\n      cutout: '80%',\n      plugins: { legend: { display: false } }\n    }\n  });\n  \n  // Render Custom Legend for Donut\n  const legendEl = $('chart-legend');\n  legendEl.innerHTML = oKeys.map((k, i) => `\n    <div class=\"flex items-center justify-between text-xs font-bold\">\n      <div class=\"flex items-center gap-2\">\n        <span class=\"w-2 h-2 rounded-full\" style=\"background:${COLORS[i%COLORS.length]}\"></span>\n        <span class=\"text-slate-400 capitalize\">${k.replace(/_/g,' ')}</span>\n      </div>\n      <span class=\"text-white\">${outcomes[k]}</span>\n    </div>\n  `).join('');\n\n  // Duration Bar Chart\n  const dur = d.duration_by_outcome || {};\n  const dKeys = Object.keys(dur);\n  const existingDur = _charts['chart-duration'];\n  if (existingDur) existingDur.destroy();\n  \n  const ctxDur = $('chart-duration').getContext('2d');\n  _charts['chart-duration'] = new Chart(ctxDur, {\n    type: 'bar',\n    data: {\n      labels: dKeys.map(k => k.replace(/_/g,' ')),\n      datasets: [{\n        data: dKeys.map(k => Math.round(dur[k])),\n        backgroundColor: COLORS,\n        borderRadius: 8,\n        barThickness: 40\n      }]\n    },\n    options: {\n      responsive: true,\n      maintainAspectRatio: false,\n      plugins: { legend: { display: false } },\n      scales: {\n        x: { grid: { display: false }, ticks: { color: '#64748b', font: { size: 10, weight: 'bold' } } },\n        y: { grid: { color: 'rgba(255,255,255,0.03)' }, ticks: { color: '#64748b', font: { size: 10, weight: 'bold' } } }\n      }\n    }\n  });\n}\n\n// CRM, Logs, Dispatch logic placeholders (reusing source patterns)\nasync function loadCRM() {\n  const d = await api('/api/crm');\n  const contacts = d.data || [];\n  const tb = $('crm-table');\n  if (!contacts.length) {\n    tb.innerHTML = '<tr><td colspan=\"5\" class=\"px-6 py-12 text-center text-slate-500\">No data found in cluster</td></tr>';\n    return;\n  }\n  tb.innerHTML = contacts.map(c => `\n    <tr class=\"hover:bg-white/5 transition-colors\">\n      <td class=\"px-6 py-4 font-mono text-cyan-400\">${c.phone_number}</td>\n      <td class=\"px-6 py-4 font-bold\">${c.lead_name || '—'}</td>\n      <td class=\"px-6 py-4\">\n        <div class=\"flex items-center gap-2\">\n          <span class=\"font-bold\">${c.total_calls}</span> calls\n          <span class=\"text-[10px] text-emerald-400 font-bold bg-emerald-400/10 px-1.5 py-0.5 rounded\">${c.booked} booked</span>\n        </div>\n      </td>\n      <td class=\"px-6 py-4\">\n        <span class=\"status-badge bg-white/5 border border-white/10 text-slate-400\">${c.last_outcome || 'N/A'}</span>\n      </td>\n      <td class=\"px-6 py-4\">\n        <button class=\"text-[10px] font-black text-cyan-400 uppercase tracking-widest hover:underline\">Inspect Profile</button>\n      </td>\n    </tr>\n  `).join('');\n}\n\n// Initialization\ndocument.addEventListener('DOMContentLoaded', () => {\n  // Use mock data for first render if API is not available\n  const mockData = {\n    total_calls: 3450,\n    booked: 1240,\n    not_interested: 520,\n    booking_rate_percent: 36,\n    avg_duration_seconds: 142,\n    outcomes: { booked: 1240, not_interested: 520, voicemail: 840, no_answer: 350, unknown: 500 },\n    timeline: [\n      {date: '2024-05-01', count: 120}, {date: '2024-05-02', count: 150},\n      {date: '2024-05-03', count: 140}, {date: '2024-05-04', count: 190},\n      {date: '2024-05-05', count: 210}, {date: '2024-05-06', count: 250},\n      {date: '2024-05-07', count: 230}, {date: '2024-05-08', count: 280},\n      {date: '2024-05-09', count: 310}, {date: '2024-05-10', count: 290},\n      {date: '2024-05-11', count: 320}, {date: '2024-05-12', count: 350},\n      {date: '2024-05-13', count: 340}, {date: '2024-05-14', count: 380}\n    ],\n    duration_by_outcome: { booked: 185, not_interested: 45, voicemail: 30, no_answer: 0, unknown: 60 }\n  };\n  \n  _renderCharts(mockData);\n  $('kpi-total').textContent = mockData.total_calls;\n  $('kpi-booked').textContent = mockData.booked;\n  $('kpi-ni').textContent = mockData.not_interested;\n  $('kpi-rate').textContent = mockData.booking_rate_percent + '%';\n  $('kpi-dur').textContent = mockData.avg_duration_seconds + 's';\n  $('donut-total').textContent = mockData.total_calls;\n\n  loadStats();\n  loadLiveConfig();\n  setInterval(loadStats, 30000);\n});\n</script>\n",
