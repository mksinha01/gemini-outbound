      "html": "\n<section class=\"flex min-h-[900px] bg-[#010B13] text-slate-300 font-['Archivo'] selection:bg-[#0FFFFF]/30\" data-kid=\"0\">\n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Archivo:wght@300;400;500;600;700&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        .font-sora { font-family: 'Sora', sans-serif; }\n        .cyber-card {\n            background: rgba(17, 24, 39, 0.4);\n            border: 1px solid rgba(255, 255, 255, 0.05);\n            backdrop-filter: blur(12px);\n            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n        }\n        .cyber-card:hover {\n            border-color: rgba(15, 255, 255, 0.4);\n            box-shadow: 0 0 40px rgba(15, 255, 255, 0.08);\n            background: rgba(17, 24, 39, 0.6);\n            transform: translateY(-2px);\n        }\n        .neon-glow-cyan {\n            box-shadow: 0 0 15px rgba(15, 255, 255, 0.2);\n        }\n        .waveform-bar {\n            background: linear-gradient(to top, #0FFFFF, #6C3082);\n            animation: waveform-pulse 1.2s ease-in-out infinite;\n        }\n        @keyframes waveform-pulse {\n            0%, 100% { height: 20%; }\n            50% { height: 80%; }\n        }\n        .avatar-frame {\n            position: relative;\n            padding: 3px;\n            background: linear-gradient(45deg, #0FFFFF, #6C3082);\n            border-radius: 1.25rem;\n            overflow: hidden;\n        }\n        .avatar-frame::after {\n            content: '';\n            position: absolute;\n            inset: 2px;\n            background: #010B13;\n            border-radius: 1.1rem;\n            z-index: 1;\n        }\n        .avatar-img {\n            position: relative;\n            z-index: 2;\n            border-radius: 1rem;\n            width: 100%;\n            height: 100%;\n            object-cover: cover;\n        }\n        .cyber-input {\n            background: rgba(255, 255, 255, 0.03);\n            border: 1px solid rgba(255, 255, 255, 0.08);\n            color: white;\n            padding: 12px 16px;\n            border-radius: 12px;\n            width: 100%;\n            transition: all 0.2s ease;\n        }\n        .cyber-input:focus {\n            outline: none;\n            border-color: #0FFFFF;\n            background: rgba(15, 255, 255, 0.05);\n            box-shadow: 0 0 15px rgba(15, 255, 255, 0.1);\n        }\n        .cyber-label {\n            display: block;\n            font-size: 11px;\n            font-weight: 700;\n            color: #94a3b8;\n            text-transform: uppercase;\n            letter-spacing: 0.1em;\n            margin-bottom: 8px;\n        }\n        .sidebar-link {\n            transition: all 0.3s ease;\n        }\n        .sidebar-link:hover {\n            background: rgba(15, 255, 255, 0.05);\n            color: #0FFFFF;\n        }\n        .sidebar-link.active {\n            background: linear-gradient(90deg, rgba(15, 255, 255, 0.12) 0%, transparent 100%);\n            color: #0FFFFF;\n            border-left: 3px solid #0FFFFF;\n            text-shadow: 0 0 8px rgba(15, 255, 255, 0.4);\n        }\n        ::-webkit-scrollbar {\n            width: 6px;\n        }\n        ::-webkit-scrollbar-track {\n            background: #010B13;\n        }\n        ::-webkit-scrollbar-thumb {\n            background: #111827;\n            border-radius: 10px;\n        }\n        ::-webkit-scrollbar-thumb:hover {\n            background: #1e293b;\n        }\n    </style>\n\n    \n    <aside class=\"w-64 border-r border-white/5 flex flex-col shrink-0 bg-[#010B13]\" data-kid=\"2\">\n        <div class=\"p-8\" data-kid=\"3\">\n            <div class=\"flex items-center gap-3\" data-kid=\"4\">\n                <div class=\"w-10 h-10 rounded-xl bg-gradient-to-br from-[#0FFFFF] to-[#6C3082] flex items-center justify-center shadow-lg\" data-kid=\"5\">\n                    <span class=\"text-[#010B13] font-sora font-extrabold text-xl\" data-kid=\"6\">O</span>\n                </div>\n                <h1 class=\"font-sora font-extrabold text-white text-xl tracking-tight\" data-kid=\"7\">Outbound<span class=\"text-[#0FFFFF] drop-shadow-[0_0_8px_rgba(15,255,255,0.5)]\" data-kid=\"8\">AI</span></h1>\n            </div>\n        </div>\n        \n        <nav class=\"flex-grow mt-4 px-4 space-y-2\" data-kid=\"9\">\n            <a href=\"#\" class=\"sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 font-medium\" data-kid=\"10\">\n                <i class=\"ti ti-layout-dashboard text-lg\" data-kid=\"11\"></i> Overview\n            </a>\n            <a href=\"#\" class=\"sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 font-medium\" data-kid=\"12\">\n                <i class=\"ti ti-rocket text-lg\" data-kid=\"13\"></i> Campaigns\n            </a>\n            <a href=\"#\" class=\"sidebar-link active flex items-center gap-3 px-4 py-3 rounded-xl font-medium\" data-kid=\"14\">\n                <i class=\"ti ti-robot text-lg\" data-kid=\"15\"></i> Agent Profiles\n            </a>\n            <a href=\"#\" class=\"sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 font-medium\" data-kid=\"16\">\n                <i class=\"ti ti-phone-call text-lg\" data-kid=\"17\"></i> Call Logs\n            </a>\n            <a href=\"#\" class=\"sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 font-medium\" data-kid=\"18\">\n                <i class=\"ti ti-users text-lg\" data-kid=\"19\"></i> CRM\n            </a>\n            <div class=\"pt-8 px-4\" data-kid=\"20\">\n                <span class=\"text-[10px] font-bold text-slate-600 uppercase tracking-widest\" data-kid=\"21\">System</span>\n            </div>\n            <a href=\"#\" class=\"sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 font-medium\" data-kid=\"22\">\n                <i class=\"ti ti-settings text-lg\" data-kid=\"23\"></i> Settings\n            </a>\n        </nav>\n        \n        <div class=\"p-6 mt-auto\" data-kid=\"24\">\n            <div class=\"bg-white/5 rounded-2xl p-4 border border-white/5\" data-kid=\"25\">\n                <div class=\"flex items-center gap-3\" data-kid=\"26\">\n                    <img src=\"https://i.pravatar.cc/100?u=admin\" class=\"w-8 h-8 rounded-lg\" alt=\"Admin\" decoding=\"async\" loading=\"lazy\" data-kid=\"27\">\n                    <div class=\"overflow-hidden\" data-kid=\"28\">\n                        <p class=\"text-xs font-bold text-white truncate\" data-kid=\"29\">Alex Rivard</p>\n                        <p class=\"text-[10px] text-slate-500 truncate\" data-kid=\"30\">Enterprise Admin</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </aside>\n\n    \n    <main class=\"flex-grow bg-[radial-gradient(ellipse_at_top_right,rgba(108,48,130,0.08),transparent_50%),radial-gradient(ellipse_at_bottom_left,rgba(15,255,255,0.03),transparent_40%)] relative\" data-kid=\"31\">\n        <div class=\"absolute inset-0 opacity-[0.03] pointer-events-none bg-[url('https://images.unsplash.com/photo-1597733336794-12d05021d510?auto=format&w=1440&q=80&fit=crop')] bg-cover mix-blend-screen\" data-kid=\"32\"></div>\n        \n        \n        <header class=\"relative z-30 flex items-center justify-between px-10 py-6 backdrop-blur-md bg-[#010B13]/80 border-b border-white/5\" data-kid=\"33\">\n            <div data-kid=\"34\">\n                <nav class=\"flex items-center gap-2 text-xs text-slate-500 font-medium mb-1\" data-kid=\"35\">\n                    <span data-kid=\"36\">Platform</span>\n                    <i class=\"ti ti-chevron-right text-[10px]\" data-kid=\"37\"></i>\n                    <span class=\"text-slate-300\" data-kid=\"38\">Agent Management</span>\n                </nav>\n                <h2 class=\"text-2xl font-sora font-extrabold text-white tracking-tight\" data-kid=\"39\">Agent Profiles</h2>\n            </div>\n            \n            <div class=\"flex items-center gap-4\" data-kid=\"40\">\n                <div class=\"hidden md:flex items-center gap-4 px-4 py-2 bg-white/5 rounded-xl border border-white/5 mr-4\" data-kid=\"41\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"42\">\n                        <span class=\"w-2 h-2 rounded-full bg-[#10b981] animate-pulse\" data-kid=\"43\"></span>\n                        <span class=\"text-xs font-bold text-slate-400 uppercase tracking-tighter\" data-kid=\"44\">System Live</span>\n                    </div>\n                    <div class=\"w-px h-4 bg-white/10\" data-kid=\"45\"></div>\n                    <div class=\"text-xs font-bold text-slate-400 uppercase tracking-tighter\" data-kid=\"46\">\n                        Active Calls: <span class=\"text-white\" data-kid=\"47\">14</span>\n                    </div>\n                </div>\n                <button class=\"flex items-center gap-2 px-6 py-3 bg-[#0FFFFF] text-[#010B13] font-bold rounded-xl shadow-[0_0_20px_rgba(15,255,255,0.2)] hover:scale-105 transition-all\" data-kid=\"48\">\n                    <i class=\"ti ti-plus\" data-kid=\"49\"></i> New Profile\n                </button>\n            </div>\n        </header>\n\n        <div class=\"p-10 max-w-7xl mx-auto space-y-16\" data-kid=\"50\">\n            \n            \n            <section data-kid=\"51\">\n                <div class=\"flex items-center justify-between mb-8\" data-kid=\"52\">\n                    <h3 class=\"text-xl font-sora font-bold text-white\" data-kid=\"53\">Deployed Personalities</h3>\n                    <div class=\"flex gap-2\" data-kid=\"54\">\n                        <button class=\"p-2 bg-white/5 hover:bg-white/10 rounded-lg text-slate-400 transition-colors\" data-kid=\"55\"><i class=\"ti ti-grid-dots\" data-kid=\"56\"></i></button>\n                        <button class=\"p-2 bg-white/5 hover:bg-white/10 rounded-lg text-slate-400 transition-colors\" data-kid=\"57\"><i class=\"ti ti-list\" data-kid=\"58\"></i></button>\n                    </div>\n                </div>\n\n                <div class=\"grid grid-cols-12 gap-6\" data-kid=\"59\">\n                    \n                    <div class=\"col-span-12 lg:col-span-8 cyber-card rounded-[2.5rem] p-8 relative overflow-hidden group\" data-kid=\"60\">\n                        \n                        <div class=\"absolute -top-24 -right-24 w-64 h-64 bg-[#0FFFFF]/5 rounded-full blur-[100px] pointer-events-none\" data-kid=\"61\"></div>\n                        \n                        <div class=\"flex flex-col md:flex-row gap-10 relative z-10\" data-kid=\"62\">\n                            <div class=\"flex-shrink-0 w-full md:w-56\" data-kid=\"63\">\n                                <div class=\"avatar-frame aspect-square\" data-kid=\"64\">\n                                    <img src=\"https://i.pravatar.cc/400?u=priya\" alt=\"Agent\" class=\"avatar-img\" decoding=\"async\" loading=\"lazy\" data-kid=\"65\">\n                                </div>\n                                <div class=\"mt-6 flex justify-center gap-1.5 h-10 items-end px-6\" data-kid=\"66\">\n                                    <div class=\"waveform-bar w-1.5 rounded-full\" style=\"animation-delay: 0.1s\" data-kid=\"67\"></div>\n                                    <div class=\"waveform-bar w-1.5 rounded-full\" style=\"animation-delay: 0.3s\" data-kid=\"68\"></div>\n                                    <div class=\"waveform-bar w-1.5 rounded-full\" style=\"animation-delay: 0.2s\" data-kid=\"69\"></div>\n                                    <div class=\"waveform-bar w-1.5 rounded-full\" style=\"animation-delay: 0.5s\" data-kid=\"70\"></div>\n                                    <div class=\"waveform-bar w-1.5 rounded-full\" style=\"animation-delay: 0.4s\" data-kid=\"71\"></div>\n                                    <div class=\"waveform-bar w-1.5 rounded-full\" style=\"animation-delay: 0.6s\" data-kid=\"72\"></div>\n                                    <div class=\"waveform-bar w-1.5 rounded-full\" style=\"animation-delay: 0.3s\" data-kid=\"73\"></div>\n                                    <div class=\"waveform-bar w-1.5 rounded-full\" style=\"animation-delay: 0.5s\" data-kid=\"74\"></div>\n                                </div>\n                            </div>\n\n                            <div class=\"flex-grow pt-2\" data-kid=\"75\">\n                                <div class=\"flex flex-wrap items-center gap-3 mb-4\" data-kid=\"76\">\n                                    <span class=\"px-4 py-1.5 bg-gradient-to-r from-[#0FFFFF]/20 to-transparent border border-[#0FFFFF]/30 text-[#0FFFFF] text-[10px] font-bold rounded-full tracking-widest uppercase shadow-[0_0_15px_rgba(15,255,255,0.1)]\" data-kid=\"77\">Primary Instance</span>\n                                    <span class=\"flex items-center gap-2 text-[#10b981] text-xs font-bold uppercase tracking-widest\" data-kid=\"78\">\n                                        <span class=\"w-2.5 h-2.5 rounded-full bg-[#10b981] shadow-[0_0_10px_#10b981] animate-pulse\" data-kid=\"79\"></span>\n                                        Live Status\n                                    </span>\n                                </div>\n                                <h3 class=\"text-5xl font-sora font-extrabold text-white mb-4 leading-tight\" data-kid=\"80\">Priya — <span class=\"text-transparent bg-clip-text bg-gradient-to-r from-[#0FFFFF] via-[#A855F7] to-[#6C3082]\" data-kid=\"81\">Medical Dispatch</span></h3>\n                                <p class=\"text-slate-400 text-lg mb-8 leading-relaxed max-w-xl\" data-kid=\"82\">Optimized for high-conversion healthcare appointments. Uses calm, authoritative tonal patterns with built-in empathy loops.</p>\n                                \n                                <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10\" data-kid=\"83\">\n                                    <div class=\"bg-white/5 rounded-2xl p-5 border border-white/5 group-hover:border-white/10 transition-colors\" data-kid=\"84\">\n                                        <div class=\"flex items-center gap-3 mb-2\" data-kid=\"85\">\n                                            <i class=\"ti ti-brain text-[#6C3082] text-xl\" data-kid=\"86\"></i>\n                                            <p class=\"text-xs text-slate-500 uppercase font-bold tracking-widest\" data-kid=\"87\">Core Intelligence</p>\n                                        </div>\n                                        <p class=\"text-white font-semibold text-lg\" data-kid=\"88\">Gemini 2.5 Realtime</p>\n                                    </div>\n                                    <div class=\"bg-white/5 rounded-2xl p-5 border border-white/5 group-hover:border-white/10 transition-colors\" data-kid=\"89\">\n                                        <div class=\"flex items-center gap-3 mb-2\" data-kid=\"90\">\n                                            <i class=\"ti ti-microphone text-[#0FFFFF] text-xl\" data-kid=\"91\"></i>\n                                            <p class=\"text-xs text-slate-500 uppercase font-bold tracking-widest\" data-kid=\"92\">Vocal Synthesis</p>\n                                        </div>\n                                        <p class=\"text-white font-semibold text-lg\" data-kid=\"93\">Aoede (Expressive)</p>\n                                    </div>\n                                </div>\n\n                                <div class=\"flex flex-wrap gap-4\" data-kid=\"94\">\n                                    <button class=\"px-8 py-3.5 bg-[#0FFFFF] text-[#010B13] font-bold rounded-xl shadow-[0_0_20px_rgba(15,255,255,0.2)] hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center gap-2\" data-kid=\"95\">\n                                        <i class=\"ti ti-microphone-2\" data-kid=\"96\"></i> Voice Preview\n                                    </button>\n                                    <button class=\"px-8 py-3.5 bg-white/5 hover:bg-white/10 text-white font-bold rounded-xl border border-white/10 transition-all flex items-center gap-2\" data-kid=\"97\">\n                                        <i class=\"ti ti-settings\" data-kid=\"98\"></i> Edit Profile\n                                    </button>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"col-span-12 lg:col-span-4 grid grid-rows-2 gap-6\" data-kid=\"99\">\n                        <div class=\"cyber-card rounded-[2.5rem] p-8 flex flex-col justify-between\" data-kid=\"100\">\n                            <div data-kid=\"101\">\n                                <h4 class=\"text-slate-500 text-[10px] font-bold uppercase tracking-[0.2em] mb-4\" data-kid=\"102\">Instance Performance</h4>\n                                <div class=\"flex items-baseline gap-2 mb-2\" data-kid=\"103\">\n                                    <span class=\"text-4xl font-sora font-extrabold text-white\" data-kid=\"104\">98.4%</span>\n                                    <span class=\"text-xs text-[#10b981] font-bold\" data-kid=\"105\">SENTIMENT OK</span>\n                                </div>\n                                <div class=\"w-full bg-white/5 h-2 rounded-full overflow-hidden mb-6\" data-kid=\"106\">\n                                    <div class=\"bg-gradient-to-r from-[#0FFFFF] to-[#6C3082] h-full w-[92%] shadow-[0_0_10px_rgba(15,255,255,0.3)]\" data-kid=\"107\"></div>\n                                </div>\n                            </div>\n                            <div class=\"flex justify-between items-center text-xs\" data-kid=\"108\">\n                                <span class=\"text-slate-500\" data-kid=\"109\">Avg. Call Duration</span>\n                                <span class=\"text-white font-bold\" data-kid=\"110\">2m 44s</span>\n                            </div>\n                        </div>\n\n                        <div class=\"bg-gradient-to-br from-[#6C3082]/20 to-[#010B13] border border-[#6C3082]/20 rounded-[2.5rem] p-8 relative overflow-hidden\" data-kid=\"111\">\n                            <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/honeycomb.svg\" class=\"absolute -bottom-10 -right-10 w-40 h-40 opacity-10 blur-xs\" alt=\"Pattern\" data-kid=\"112\">\n                            <h4 class=\"text-slate-300 text-[10px] font-bold uppercase tracking-[0.2em] mb-4 relative z-10\" data-kid=\"113\">Active Neural Threads</h4>\n                            <div class=\"flex flex-col gap-3 relative z-10\" data-kid=\"114\">\n                                <div class=\"flex justify-between items-center bg-white/5 p-3 rounded-xl border border-white/5\" data-kid=\"115\">\n                                    <span class=\"text-xs font-bold text-slate-400\" data-kid=\"116\">THREADS_ALLOCATED</span>\n                                    <span class=\"text-[#0FFFFF] font-mono font-bold\" data-kid=\"117\">128/512</span>\n                                </div>\n                                <div class=\"flex justify-between items-center bg-white/5 p-3 rounded-xl border border-white/5\" data-kid=\"118\">\n                                    <span class=\"text-xs font-bold text-slate-400\" data-kid=\"119\">LATENCY_MS</span>\n                                    <span class=\"text-[#0FFFFF] font-mono font-bold\" data-kid=\"120\">24ms</span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"col-span-12 md:col-span-6 lg:col-span-4 cyber-card rounded-[2.5rem] p-8 flex flex-col justify-between group\" data-kid=\"121\">\n                        <div class=\"flex justify-between items-start mb-8\" data-kid=\"122\">\n                            <div class=\"avatar-frame w-20 h-20\" data-kid=\"123\">\n                                <img src=\"https://i.pravatar.cc/200?u=marcus\" alt=\"Agent\" class=\"avatar-img\" decoding=\"async\" loading=\"lazy\" data-kid=\"124\">\n                            </div>\n                            <div class=\"flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"125\">\n                                <button class=\"w-10 h-10 flex items-center justify-center rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-slate-400 transition-colors\" data-kid=\"126\">\n                                    <i class=\"ti ti-settings\" data-kid=\"127\"></i>\n                                </button>\n                            </div>\n                        </div>\n                        <div data-kid=\"128\">\n                            <div class=\"flex items-center gap-2 mb-2\" data-kid=\"129\">\n                                <span class=\"px-2 py-0.5 bg-white/5 border border-white/10 text-[9px] text-slate-400 font-bold rounded uppercase\" data-kid=\"130\">Cold Outreach</span>\n                                <span class=\"w-1.5 h-1.5 rounded-full bg-slate-600\" data-kid=\"131\"></span>\n                                <span class=\"text-[9px] text-slate-500 font-bold uppercase\" data-kid=\"132\">Standby</span>\n                            </div>\n                            <h4 class=\"text-2xl font-sora font-bold text-white mb-2\" data-kid=\"133\">Marcus Executive</h4>\n                            <p class=\"text-slate-500 text-sm leading-relaxed mb-6\" data-kid=\"134\">Aggressive, high-energy sales voice with objection handling loops.</p>\n                        </div>\n                        <div class=\"flex items-center justify-between mt-4 pt-6 border-t border-white/5\" data-kid=\"135\">\n                            <div class=\"flex gap-1 items-end h-8\" data-kid=\"136\">\n                                <div class=\"waveform-bar w-1 rounded-full opacity-30\" style=\"animation-delay: 0.2s\" data-kid=\"137\"></div>\n                                <div class=\"waveform-bar w-1 rounded-full opacity-30\" style=\"animation-delay: 0.4s\" data-kid=\"138\"></div>\n                                <div class=\"waveform-bar w-1 rounded-full opacity-30\" style=\"animation-delay: 0.3s\" data-kid=\"139\"></div>\n                            </div>\n                            <span class=\"text-[10px] font-mono text-slate-600\" data-kid=\"140\">TTS: ALGENIB</span>\n                        </div>\n                    </div>\n\n                    <div class=\"col-span-12 md:col-span-6 lg:col-span-4 cyber-card rounded-[2.5rem] p-8 flex flex-col justify-between group\" data-kid=\"141\">\n                        <div class=\"flex justify-between items-start mb-8\" data-kid=\"142\">\n                            <div class=\"avatar-frame w-20 h-20\" data-kid=\"143\">\n                                <img src=\"https://i.pravatar.cc/200?u=elara\" alt=\"Agent\" class=\"avatar-img\" decoding=\"async\" loading=\"lazy\" data-kid=\"144\">\n                            </div>\n                            <div class=\"flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"145\">\n                                <button class=\"w-10 h-10 flex items-center justify-center rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-slate-400 transition-colors\" data-kid=\"146\">\n                                    <i class=\"ti ti-settings\" data-kid=\"147\"></i>\n                                </button>\n                            </div>\n                        </div>\n                        <div data-kid=\"148\">\n                            <div class=\"flex items-center gap-2 mb-2\" data-kid=\"149\">\n                                <span class=\"px-2 py-0.5 bg-white/5 border border-white/10 text-[9px] text-slate-400 font-bold rounded uppercase\" data-kid=\"150\">Customer Support</span>\n                                <span class=\"w-1.5 h-1.5 rounded-full bg-[#10b981]\" data-kid=\"151\"></span>\n                                <span class=\"text-[9px] text-[#10b981] font-bold uppercase\" data-kid=\"152\">Idle</span>\n                            </div>\n                            <h4 class=\"text-2xl font-sora font-bold text-white mb-2\" data-kid=\"153\">Elara Gen-Z</h4>\n                            <p class=\"text-slate-500 text-sm leading-relaxed mb-6\" data-kid=\"154\">Friendly, casual support agent using natural speech fillers.</p>\n                        </div>\n                        <div class=\"flex items-center justify-between mt-4 pt-6 border-t border-white/5\" data-kid=\"155\">\n                            <div class=\"flex gap-1 items-end h-8\" data-kid=\"156\">\n                                <div class=\"waveform-bar w-1 rounded-full opacity-30\" style=\"animation-delay: 0.5s\" data-kid=\"157\"></div>\n                                <div class=\"waveform-bar w-1 rounded-full opacity-30\" style=\"animation-delay: 0.1s\" data-kid=\"158\"></div>\n                                <div class=\"waveform-bar w-1 rounded-full opacity-30\" style=\"animation-delay: 0.6s\" data-kid=\"159\"></div>\n                            </div>\n                            <span class=\"text-[10px] font-mono text-slate-600\" data-kid=\"160\">TTS: CALLIRRHOE</span>\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"col-span-12 md:col-span-6 lg:col-span-4 border-2 border-dashed border-white/10 rounded-[2.5rem] p-8 flex flex-col items-center justify-center text-center hover:border-[#0FFFFF]/40 hover:bg-[#0FFFFF]/5 transition-all cursor-pointer group\" data-kid=\"161\">\n                        <div class=\"w-16 h-16 rounded-2xl bg-white/5 flex items-center justify-center mb-6 group-hover:bg-[#0FFFFF]/20 group-hover:scale-110 transition-all shadow-inner\" data-kid=\"162\">\n                            <i class=\"ti ti-plus text-[#0FFFFF] text-3xl\" data-kid=\"163\"></i>\n                        </div>\n                        <h4 class=\"text-white font-sora font-bold text-xl mb-2\" data-kid=\"164\">New Identity</h4>\n                        <p class=\"text-slate-500 text-sm max-w-[200px] leading-relaxed\" data-kid=\"165\">Design a custom neural personality from scratch</p>\n                    </div>\n                </div>\n            </section>\n\n            \n            <section class=\"pt-24\" data-kid=\"166\">\n                <div class=\"flex items-center gap-4 mb-8\" data-kid=\"167\">\n                    <h3 class=\"text-xl font-sora font-bold text-white\" data-kid=\"168\">Profile Creation</h3>\n                    <div class=\"h-px flex-grow bg-white/5\" data-kid=\"169\"></div>\n                </div>\n\n                <div class=\"cyber-card rounded-[3rem] overflow-hidden border-[#0FFFFF]/10\" data-kid=\"170\">\n                    <div class=\"bg-gradient-to-r from-[#0FFFFF]/10 to-transparent p-10 border-b border-white/5 flex flex-col md:flex-row md:items-center justify-between gap-6\" data-kid=\"171\">\n                        <div class=\"flex items-center gap-6\" data-kid=\"172\">\n                            <div class=\"w-16 h-16 rounded-[1.25rem] bg-gradient-to-br from-[#0FFFFF] to-[#6C3082] flex items-center justify-center shadow-[0_0_30px_rgba(15,255,255,0.2)]\" data-kid=\"173\">\n                                <i class=\"ti ti-microphone text-[#010B13] text-3xl font-bold\" data-kid=\"174\"></i>\n                            </div>\n                            <div data-kid=\"175\">\n                                <h3 class=\"text-3xl font-sora font-extrabold text-white tracking-tight\" data-kid=\"176\">Agent Architect</h3>\n                                <p class=\"text-slate-400 text-sm mt-1\" data-kid=\"177\">Configure neural weights, vocal synthesis, and logic tools</p>\n                            </div>\n                        </div>\n                        <div class=\"flex gap-3\" data-kid=\"178\">\n                            <button class=\"px-6 py-3 bg-white/5 hover:bg-white/10 rounded-xl text-xs font-bold text-slate-300 transition-all uppercase tracking-widest border border-white/5\" data-kid=\"179\">Cancel Build</button>\n                            <button class=\"px-8 py-3 bg-[#0FFFFF] text-[#010B13] rounded-xl text-xs font-bold transition-all hover:scale-105 active:scale-95 shadow-[0_0_25px_rgba(15,255,255,0.3)] uppercase tracking-widest\" data-kid=\"180\">Deploy Instance</button>\n                        </div>\n                    </div>\n\n                    <div class=\"p-10 grid grid-cols-1 lg:grid-cols-12 gap-12\" data-kid=\"181\">\n                        \n                        <div class=\"lg:col-span-5 space-y-8\" data-kid=\"182\">\n                            <div class=\"group\" data-kid=\"183\">\n                                <label class=\"cyber-label group-focus-within:text-[#0FFFFF] transition-colors\" data-kid=\"184\">Identity Designation</label>\n                                <input type=\"text\" placeholder=\"e.g. Rahul — Senior Admissions\" class=\"cyber-input font-medium placeholder:text-slate-600\" data-kid=\"185\">\n                            </div>\n\n                            <div class=\"grid grid-cols-1 gap-6\" data-kid=\"186\">\n                                <div class=\"group\" data-kid=\"187\">\n                                    <label class=\"cyber-label group-focus-within:text-[#0FFFFF] transition-colors\" data-kid=\"188\">Vocal Matrix</label>\n                                    <div class=\"relative\" data-kid=\"189\">\n                                        <select class=\"cyber-input appearance-none pr-10 cursor-pointer text-sm font-medium\" data-kid=\"190\">\n                                            <option data-kid=\"191\">Aoede — Warm & Expressive (Featured)</option>\n                                            <option data-kid=\"192\">Fenrir — Confident Male Voice</option>\n                                            <option data-kid=\"193\">Callirrhoe — Gentle Female Persona</option>\n                                            <option data-kid=\"194\">Achernar — Soft & High-Clarity Voice</option>\n                                            <option data-kid=\"195\">Puck — High Energy Masculine</option>\n                                        </select>\n                                        <i class=\"ti ti-chevron-down absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-slate-500\" data-kid=\"196\"></i>\n                                    </div>\n                                </div>\n                                <div class=\"group\" data-kid=\"197\">\n                                    <label class=\"cyber-label group-focus-within:text-[#0FFFFF] transition-colors\" data-kid=\"198\">Intelligence Engine</label>\n                                    <div class=\"relative\" data-kid=\"199\">\n                                        <select class=\"cyber-input appearance-none pr-10 cursor-pointer text-sm font-medium\" data-kid=\"200\">\n                                            <option data-kid=\"201\">Gemini 2.5 Realtime — Ultra-low Latency</option>\n                                            <option data-kid=\"202\">Gemini 2.0 Flash — High Performance</option>\n                                            <option data-kid=\"203\">Deepgram Pipeline — Standard Latency</option>\n                                        </select>\n                                        <i class=\"ti ti-chevron-down absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-slate-500\" data-kid=\"204\"></i>\n                                    </div>\n                                </div>\n                            </div>\n\n                            <div class=\"space-y-4\" data-kid=\"205\">\n                                <label class=\"cyber-label\" data-kid=\"206\">Operational Toolkits</label>\n                                <div class=\"grid grid-cols-2 gap-3\" data-kid=\"207\">\n                                    <label class=\"flex items-center gap-3 px-4 py-3 bg-white/5 border border-white/5 rounded-2xl cursor-pointer hover:bg-[#0FFFFF]/5 hover:border-[#0FFFFF]/20 transition-all peer-group\" data-kid=\"208\">\n                                        <input type=\"checkbox\" checked class=\"hidden peer\" data-kid=\"209\">\n                                        <div class=\"w-6 h-6 border-2 border-slate-700 rounded-lg flex items-center justify-center peer-checked:bg-[#0FFFFF] peer-checked:border-[#0FFFFF] peer-checked:shadow-[0_0_10px_rgba(15,255,255,0.5)] transition-all\" data-kid=\"210\">\n                                            <i class=\"ti ti-check text-xs text-[#010B13] font-bold\" data-kid=\"211\"></i>\n                                        </div>\n                                        <div class=\"flex flex-col\" data-kid=\"212\">\n                                            <span class=\"text-xs font-bold text-slate-300 uppercase tracking-tighter\" data-kid=\"213\">Cal.com Sync</span>\n                                        </div>\n                                    </label>\n                                    <label class=\"flex items-center gap-3 px-4 py-3 bg-white/5 border border-white/5 rounded-2xl cursor-pointer hover:bg-[#0FFFFF]/5 hover:border-[#0FFFFF]/20 transition-all\" data-kid=\"214\">\n                                        <input type=\"checkbox\" checked class=\"hidden peer\" data-kid=\"215\">\n                                        <div class=\"w-6 h-6 border-2 border-slate-700 rounded-lg flex items-center justify-center peer-checked:bg-[#0FFFFF] peer-checked:border-[#0FFFFF] peer-checked:shadow-[0_0_10px_rgba(15,255,255,0.5)] transition-all\" data-kid=\"216\">\n                                            <i class=\"ti ti-check text-xs text-[#010B13] font-bold\" data-kid=\"217\"></i>\n                                        </div>\n                                        <div class=\"flex flex-col\" data-kid=\"218\">\n                                            <span class=\"text-xs font-bold text-slate-300 uppercase tracking-tighter\" data-kid=\"219\">CRM Mapping</span>\n                                        </div>\n                                    </label>\n                                    <label class=\"flex items-center gap-3 px-4 py-3 bg-white/5 border border-white/5 rounded-2xl cursor-pointer hover:bg-[#0FFFFF]/5 hover:border-[#0FFFFF]/20 transition-all\" data-kid=\"220\">\n                                        <input type=\"checkbox\" class=\"hidden peer\" data-kid=\"221\">\n                                        <div class=\"w-6 h-6 border-2 border-slate-700 rounded-lg flex items-center justify-center peer-checked:bg-[#0FFFFF] peer-checked:border-[#0FFFFF] peer-checked:shadow-[0_0_10px_rgba(15,255,255,0.5)] transition-all\" data-kid=\"222\">\n                                            <i class=\"ti ti-check text-xs text-[#010B13] font-bold\" data-kid=\"223\"></i>\n                                        </div>\n                                        <div class=\"flex flex-col\" data-kid=\"224\">\n                                            <span class=\"text-xs font-bold text-slate-300 uppercase tracking-tighter\" data-kid=\"225\">Live Transfer</span>\n                                        </div>\n                                    </label>\n                                    <label class=\"flex items-center gap-3 px-4 py-3 bg-white/5 border border-white/5 rounded-2xl cursor-pointer hover:bg-[#0FFFFF]/5 hover:border-[#0FFFFF]/20 transition-all\" data-kid=\"226\">\n                                        <input type=\"checkbox\" class=\"hidden peer\" data-kid=\"227\">\n                                        <div class=\"w-6 h-6 border-2 border-slate-700 rounded-lg flex items-center justify-center peer-checked:bg-[#0FFFFF] peer-checked:border-[#0FFFFF] peer-checked:shadow-[0_0_10px_rgba(15,255,255,0.5)] transition-all\" data-kid=\"228\">\n                                            <i class=\"ti ti-check text-xs text-[#010B13] font-bold\" data-kid=\"229\"></i>\n                                        </div>\n                                        <div class=\"flex flex-col\" data-kid=\"230\">\n                                            <span class=\"text-xs font-bold text-slate-300 uppercase tracking-tighter\" data-kid=\"231\">SMS Dispatch</span>\n                                        </div>\n                                    </label>\n                                </div>\n                            </div>\n                        </div>\n\n                        \n                        <div class=\"lg:col-span-7 flex flex-col min-h-[400px]\" data-kid=\"232\">\n                            <div class=\"flex justify-between items-center mb-4\" data-kid=\"233\">\n                                <label class=\"cyber-label !mb-0\" data-kid=\"234\">Neural Behavioral Directives</label>\n                                <div class=\"flex items-center gap-3\" data-kid=\"235\">\n                                    <span class=\"px-2 py-0.5 bg-[#6C3082]/10 border border-[#6C3082]/30 text-[9px] text-[#6C3082] font-bold rounded\" data-kid=\"236\">ENFORCED</span>\n                                    <span class=\"text-[10px] font-mono text-slate-500\" data-kid=\"237\">TOKENS: 512/12000</span>\n                                </div>\n                            </div>\n                            <div class=\"flex-grow group relative\" data-kid=\"238\">\n                                <textarea class=\"cyber-input h-full w-full font-mono text-sm leading-relaxed resize-none p-6 border-white/10 group-focus-within:border-[#0FFFFF]/30\" placeholder=\"[SYSTEM_PROMPT]\nDefine your agent's persona here. Include specific knowledge, tonal constraints, and goal-oriented behaviors...\" data-kid=\"239\"></textarea>\n                                <div class=\"absolute bottom-4 right-4 flex gap-2\" data-kid=\"240\">\n                                    <button class=\"p-2 bg-white/5 hover:bg-white/10 rounded-lg text-slate-500 border border-white/5 transition-colors\" title=\"Load Template\" data-kid=\"241\"><i class=\"ti ti-template\" data-kid=\"242\"></i></button>\n                                    <button class=\"p-2 bg-white/5 hover:bg-white/10 rounded-lg text-slate-500 border border-white/5 transition-colors\" title=\"Optimize with AI\" data-kid=\"243\"><i class=\"ti ti-sparkles text-[#0FFFFF]\" data-kid=\"244\"></i></button>\n                                </div>\n                            </div>\n                            <div class=\"mt-6 p-5 rounded-2xl bg-gradient-to-br from-[#6C3082]/10 to-[#010B13] border border-[#6C3082]/20 flex items-start gap-4\" data-kid=\"245\">\n                                <div class=\"w-10 h-10 shrink-0 rounded-xl bg-[#6C3082]/20 flex items-center justify-center\" data-kid=\"246\">\n                                    <i class=\"ti ti-bulb text-[#6C3082] text-xl\" data-kid=\"247\"></i>\n                                </div>\n                                <div class=\"text-xs text-slate-400 leading-relaxed italic\" data-kid=\"248\">\n                                    <p class=\"mb-1\" data-kid=\"249\">Contextual Injection active. You can use global tags like <code class=\"text-white font-bold bg-white/10 px-1 rounded-sm\" data-kid=\"250\">{lead_name}</code> or <code class=\"text-white font-bold bg-white/10 px-1 rounded-sm\" data-kid=\"251\">{business_name}</code> within your directives.</p>\n                                    <p data-kid=\"252\">The agent will automatically switch between empathetic listening and proactive closing based on real-time sentiment analysis.</p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    \n                    \n                    <div class=\"px-10 py-6 bg-white/5 border-t border-white/5 flex flex-col md:flex-row md:items-center justify-between gap-6\" data-kid=\"253\">\n                        <div class=\"flex flex-wrap items-center gap-8\" data-kid=\"254\">\n                            <div class=\"flex items-center gap-2 group cursor-help\" data-kid=\"255\">\n                                <span class=\"w-3 h-3 rounded-full bg-[#10b981] shadow-[0_0_8px_#10b981]\" data-kid=\"256\"></span>\n                                <span class=\"text-[10px] font-bold text-slate-400 uppercase tracking-widest group-hover:text-white transition-colors\" data-kid=\"257\">Safety Filters Active</span>\n                            </div>\n                            <button class=\"flex items-center gap-2 group text-slate-500 hover:text-white transition-colors\" data-kid=\"258\">\n                                <i class=\"ti ti-adjustments-horizontal text-lg group-hover:rotate-90 transition-transform duration-500\" data-kid=\"259\"></i>\n                                <span class=\"text-[10px] font-bold uppercase tracking-widest\" data-kid=\"260\">Temperature & Sampling</span>\n                            </button>\n                            <button class=\"flex items-center gap-2 group text-slate-500 hover:text-white transition-colors\" data-kid=\"261\">\n                                <i class=\"ti ti-shield-check text-lg\" data-kid=\"262\"></i>\n                                <span class=\"text-[10px] font-bold uppercase tracking-widest\" data-kid=\"263\">Ethics Overrides</span>\n                            </button>\n                        </div>\n                        <div class=\"flex items-center gap-4\" data-kid=\"264\">\n                            <span class=\"text-[10px] font-bold text-slate-500 uppercase tracking-widest\" data-kid=\"265\">Syncing Config...</span>\n                            <div class=\"w-24 h-1.5 bg-white/5 rounded-full overflow-hidden\" data-kid=\"266\">\n                                <div class=\"bg-gradient-to-r from-[#0FFFFF] to-[#6C3082] h-full w-[65%]\" data-kid=\"267\"></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </section>\n        </div>\n\n        \n        <div class=\"h-20\" data-kid=\"268\"></div>\n    </main>\n</section>\n",
