      "html": "\n<div class=\"flex min-h-[950px] bg-[#010B13] text-slate-300 font-archivo antialiased selection:bg-[#0FFFFF]/30 selection:text-white\" data-kid=\"0\">\n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Archivo:wght@300;400;500;600&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    .font-sora { font-family: 'Sora', sans-serif; }\n    .font-archivo { font-family: 'Archivo', sans-serif; }\n\n    /* Custom Scrollbar */\n    ::-webkit-scrollbar { width: 5px; height: 5px; }\n    ::-webkit-scrollbar-track { background: transparent; }\n    ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.1); border-radius: 10px; }\n    ::-webkit-scrollbar-thumb:hover { background: rgba(15, 255, 255, 0.3); }\n\n    .neon-text-cyan { text-shadow: 0 0 10px rgba(15, 255, 255, 0.4); }\n    .neon-glow-cyan { box-shadow: 0 0 20px rgba(15, 255, 255, 0.1); }\n    \n    .pulse-cyan { animation: pulse-cyan 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }\n    @keyframes pulse-cyan { \n      0%, 100% { opacity: 1; transform: scale(1); box-shadow: 0 0 0 0 rgba(15, 255, 255, 0.7); } \n      50% { opacity: .7; transform: scale(1.1); box-shadow: 0 0 0 8px rgba(15, 255, 255, 0); } \n    }\n\n    .pulse-orchid { animation: pulse-orchid 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }\n    @keyframes pulse-orchid { \n      0%, 100% { opacity: 1; } \n      50% { opacity: .5; } \n    }\n\n    .cyber-card {\n      background: rgba(17, 24, 39, 0.6);\n      backdrop-filter: blur(20px);\n      border: 1px solid rgba(255, 255, 255, 0.05);\n      transition: all 0.3s ease;\n    }\n    .cyber-card:hover {\n      border-color: rgba(15, 255, 255, 0.2);\n      background: rgba(17, 24, 39, 0.8);\n    }\n\n    .cyber-input {\n      background: rgba(0, 0, 0, 0.3);\n      border: 1px solid rgba(255, 255, 255, 0.08);\n      color: white;\n      transition: all 0.3s ease;\n    }\n    .cyber-input:focus {\n      border-color: #0FFFFF;\n      background: rgba(15, 255, 255, 0.05);\n      outline: none;\n      box-shadow: 0 0 15px rgba(15, 255, 255, 0.1);\n    }\n\n    .gradient-text {\n      background: linear-gradient(135deg, #0FFFFF 0%, #6C3082 100%);\n      -webkit-background-clip: text;\n      -webkit-text-fill-color: transparent;\n    }\n\n    .btn-gradient {\n      background: linear-gradient(135deg, #0FFFFF 0%, #6C3082 100%);\n      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n    }\n    .btn-gradient:hover {\n      filter: brightness(1.1);\n      box-shadow: 0 0 25px rgba(15, 255, 255, 0.3);\n      transform: translateY(-2px);\n    }\n\n    .bg-grid {\n      background-image: radial-gradient(circle at 2px 2px, rgba(15, 255, 255, 0.03) 1px, transparent 0);\n      background-size: 32px 32px;\n      position: relative;\n    }\n    .bg-grid::before {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      background: url('https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/honeycomb.svg');\n      background-size: 400px;\n      opacity: 0.015;\n      pointer-events: none;\n    }\n  </style>\n\n  \n  <aside class=\"w-64 border-r border-white/5 flex flex-col shrink-0 bg-[#010B13] z-50\" data-kid=\"2\">\n    <div class=\"p-6 pb-4\" data-kid=\"3\">\n      <div class=\"flex items-center gap-4 group cursor-pointer\" data-kid=\"4\">\n        <div class=\"w-12 h-12 rounded-2xl bg-gradient-to-br from-[#0FFFFF] to-[#6C3082] flex items-center justify-center shadow-[0_0_30px_rgba(15,255,255,0.2)] group-hover:scale-110 transition-transform duration-500 relative overflow-hidden\" data-kid=\"5\">\n          <div class=\"absolute inset-0 bg-white/10 opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"6\"></div>\n          <i class=\"ti ti-robot text-white text-2xl\" data-kid=\"7\"></i>\n        </div>\n        <div class=\"flex flex-col\" data-kid=\"8\">\n          <span class=\"text-2xl font-sora font-extrabold text-white tracking-tighter leading-none\" data-kid=\"9\">Outbound<span class=\"gradient-text\" data-kid=\"10\">AI</span></span>\n          <span class=\"text-[10px] font-archivo font-bold text-[#0FFFFF]/50 uppercase tracking-[0.2em] mt-1.5\" data-kid=\"11\">Hyper-Dialer</span>\n        </div>\n      </div>\n    </div>\n\n    <nav class=\"px-4 space-y-1 mt-6\" data-kid=\"12\">\n      <a href=\"#\" class=\"flex items-center gap-3 px-4 py-2.5 rounded-xl text-slate-500 hover:text-white hover:bg-white/5 transition-all group\" data-kid=\"13\">\n        <i class=\"ti ti-layout-dashboard text-lg\" data-kid=\"14\"></i>\n        <span class=\"text-xs font-archivo font-medium\" data-kid=\"15\">Analytics</span>\n      </a>\n      <a href=\"#\" class=\"flex items-center gap-3 px-4 py-2.5 rounded-xl bg-[#0FFFFF]/10 text-[#0FFFFF] border border-[#0FFFFF]/20 shadow-[0_0_20px_rgba(15,255,255,0.1)] group\" data-kid=\"16\">\n        <i class=\"ti ti-rocket text-lg shadow-[0_0_10px_rgba(15,255,255,0.5)]\" data-kid=\"17\"></i>\n        <span class=\"text-xs font-archivo font-bold\" data-kid=\"18\">Campaigns</span>\n        <span class=\"ml-auto w-1.5 h-1.5 rounded-full bg-[#0FFFFF] pulse-cyan\" data-kid=\"19\"></span>\n      </a>\n      <a href=\"#\" class=\"flex items-center gap-3 px-4 py-2.5 rounded-xl text-slate-500 hover:text-white hover:bg-white/5 transition-all\" data-kid=\"20\">\n        <i class=\"ti ti-users text-lg\" data-kid=\"21\"></i>\n        <span class=\"text-xs font-archivo font-medium\" data-kid=\"22\">CRM Ledger</span>\n      </a>\n      <a href=\"#\" class=\"flex items-center gap-3 px-4 py-2.5 rounded-xl text-slate-500 hover:text-white hover:bg-white/5 transition-all\" data-kid=\"23\">\n        <i class=\"ti ti-microphone text-lg\" data-kid=\"24\"></i>\n        <span class=\"text-xs font-archivo font-medium\" data-kid=\"25\">Agent Profiles</span>\n      </a>\n      <a href=\"#\" class=\"flex items-center gap-3 px-4 py-2.5 rounded-xl text-slate-500 hover: