      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Archivo:wght@400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg: #010B13;\n    --surface: #0a0f18;\n    --surface-card: #111827;\n    --cyan: #0FFFFF;\n    --orchid: #6C3082;\n    --text-main: #e2e8f0;\n    --text-dim: #94a3b8;\n    --border: rgba(15, 255, 255, 0.08);\n    --success: #10b981;\n    --danger: #ef4444;\n    --warning: #f59e0b;\n  }\n\n  body {\n    background-color: var(--bg);\n    color: var(--text-main);\n    font-family: 'Archivo', sans-serif;\n    margin: 0;\n    padding: 0;\n  }\n\n  .font-sora { font-family: 'Sora', sans-serif; }\n\n  @keyframes gradient-x {\n    0%, 100% { background-position: 0% 50%; }\n    50% { background-position: 100% 50%; }\n  }\n  .animate-gradient-x {\n    animation: gradient-x 6s ease infinite;\n  }\n\n  @keyframes pulse-soft {\n    0%, 100% { transform: scale(1); opacity: 1; }\n    50% { transform: scale(1.1); opacity: 0.7; }\n  }\n  .animate-pulse-soft {\n    animation: pulse-soft 2s infinite;\n  }\n\n  /* Glassmorphism Utility */\n  .glass {\n    background: rgba(17, 24, 39, 0.6);\n    backdrop-filter: blur(16px);\n    border: 1px solid var(--border);\n  }\n\n  /* Neon Glow Utilities */\n  .neon-cyan {\n    box-shadow: 0 0 15px rgba(15, 255, 255, 0.2);\n  }\n  .neon-text-cyan {\n    text-shadow: 0 0 8px rgba(15, 255, 255, 0.5);\n  }\n\n  /* Custom Scrollbar */\n  ::-webkit-scrollbar { width: 6px; }\n  ::-webkit-scrollbar-track { background: transparent; }\n  ::-webkit-scrollbar-thumb { background: rgba(15, 255, 255, 0.1); border-radius: 10px; }\n  ::-webkit-scrollbar-thumb:hover { background: rgba(15, 255, 255, 0.3); }\n\n  /* Waveform Animation Mock */\n  .waveform-bar {\n    width: 2px;\n    background: var(--text-dim);\n    border-radius: 1px;\n  }\n  .waveform-bar.active {\n    background: var(--cyan);\n    box-shadow: 0 0 5px var(--cyan);\n  }\n\n  /* Sidebar Left Accent */\n  .sidebar-active {\n    background: linear-gradient(90deg, rgba(15, 255, 255, 0.1) 0%, transparent 100%);\n    border-left: 3px solid var(--cyan);\n    color: var(--cyan) !important;\n  }\n\n  /* Row Hover Effect */\n  .row-hover {\n    transition: all 0.3s ease;\n    border: 1px solid transparent;\n  }\n  .row-hover:hover {\n    background: rgba(30, 41, 59, 0.4);\n    border-color: rgba(15, 255, 255, 0.2);\n    transform: translateX(4px);\n  }\n\n  /* Background Glows & Textures */\n  .bg-honeycomb {\n    background-image: url(\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/honeycomb.svg\");\n    background-size: 80px;\n    opacity: 0.02;\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    z-index: 0;\n  }\n\n  .bg-glow-1 {\n    position: absolute;\n    top: -100px;\n    right: -100px;\n    width: 600px;\n    height: 600px;\n    background: radial-gradient(circle, rgba(108, 48, 130, 0.2) 0%, transparent 70%);\n    pointer-events: none;\n    z-index: 0;\n  }\n  .bg-glow-2 {\n    position: absolute;\n    bottom: -100px;\n    left: -100px;\n    width: 600px;\n    height: 600px;\n    background: radial-gradient(circle, rgba(15, 255, 255, 0.08) 0%, transparent 70%);\n    pointer-events: none;\n    z-index: 0;\n  }\n</style>\n\n<div class=\"flex min-h-[1200px] relative overflow-hidden\" data-kid=\"1\">\n  <div class=\"bg-glow-1\" data-kid=\"2\"></div>\n  <div class=\"bg-glow-2\" data-kid=\"3\"></div>\n  \n  \n  <aside class=\"w-64 glass border-r border-white/5 flex flex-col z-50 relative shrink-0\" data-kid=\"4\">\n    <div class=\"p-6 flex items-center gap-3\" data-kid=\"5\">\n      <div class=\"w-9 h-9 rounded-lg bg-linear-to-br from-[var(--cyan)] to-[var(--orchid)] flex items-center justify-center shadow-[0_0_15px_rgba(15,255,255,0.4)]\" data-kid=\"6\">\n        <i class=\"ti ti-robot text-black text-xl\" data-kid=\"7\"></i>\n      </div>\n    